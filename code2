#!/data/data/com.termux/files/usr/bin/bash
set -e

CONFIG_DIR="$HOME/.config/code"
LAST_FILE="$CONFIG_DIR/last_model"
GGUF_DIR="$HOME/storage/shared/Models"
TARGET_DIR="/data/data/com.termux/files/usr/var/lib/proot-distro/containers/ubuntu/rootfs/root/projects"

mkdir -p "$CONFIG_DIR"

start_ollama() {
if ! pgrep -f "ollama serve" >/dev/null; then
 echo "Starting Ollama..."
 nohup ollama serve >/dev/null 2>&1 &
 sleep 3
fi
}

status() {
COUNT=$(ollama list | awk 'NR>1'|wc -l)
LAST=$(cat "$LAST_FILE" 2>/dev/null || echo "None")
echo "====================================="
echo " AI Development Environment"
echo "====================================="
echo "Ollama : Running"
echo "Models  : $COUNT"
echo "Last    : $LAST"
echo
}

select_model(){
mapfile -t MODELS < <(ollama list|awk 'NR>1{print $1}')
[ ${#MODELS[@]} -eq 0 ] && { echo "No models."; exit 1; }
echo "Installed models:"
for i in "${!MODELS[@]}"; do
 mark=""
 [ "${MODELS[$i]}" = "$(cat "$LAST_FILE" 2>/dev/null)" ] && mark=" ⭐"
 printf "%2d) %s%s
" $((i+1)) "${MODELS[$i]}" "$mark"
done
read -p "Choose model [1]: " c
c=${c:-1}
MODEL="${MODELS[$((c-1))]}"
echo "$MODEL" > "$LAST_FILE"
}

select_project(){
echo "Projects:"
select dir in "$TARGET_DIR"/*/; do
 [ -n "$dir" ] && { PROJECT_NAME=$(basename "${dir%/}"); break; }
done
}

launch(){
select_model
select_project
proot-distro login ubuntu -- bash -lc "cd projects/$PROJECT_NAME && aider --model ollama_chat/$MODEL"
}

chat(){
select_model
ollama run "$MODEL"
}

import_model(){
mapfile -t G < <(find "$GGUF_DIR" -maxdepth 1 -name "*.gguf"|sort)
echo "GGUF files:"
select f in "${G[@]}"; do [ -n "$f" ] && break; done
read -p "Model name: " N
TMP=$(mktemp)
echo "FROM $f" > "$TMP"
ollama create "$N" -f "$TMP"
rm -f "$TMP"
}

restart_ollama(){ pkill ollama || true; nohup ollama serve >/dev/null 2>&1 & sleep 3; }

start_ollama
status
echo "1) Launch Aider"
echo "2) Import GGUF"
echo "3) Chat"
echo "4) Update AI"
echo "5) Doctor AI"
echo "6) Restart Ollama"
echo "7) Quit"
read -p "Choice: " m
case "$m" in
1) launch;;
2) import_model;;
3) chat;;
4) update-ai;;
5) doctor-ai;;
6) restart_ollama;;
*) exit 0;;
esac
