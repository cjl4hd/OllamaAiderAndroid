#!/data/data/com.termux/files/usr/bin/bash

CONFIG_FILE="$HOME/.ai-env.conf"
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
UBUNTU_DISTRO_NAME="${UBUNTU_DISTRO_NAME:-ubuntu}"

GREEN="\033[0;32m"
RED="\033[0;31m"
RESET="\033[0m"

pass() {
    echo -e "${GREEN}✓${RESET} $1"
}

fail() {
    echo -e "${RED}✗${RESET} $1"
}

# Resolve a binary inside Ubuntu without relying on non-interactive PATH:
# nvm/node installers append to ~/.bashrc after Ubuntu's interactive-only
# guard, so 'bash -lc' shells never see npm-installed CLIs.
in_ubuntu_path() {
    proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc '
        for c in "/usr/local/bin/$1" "/usr/bin/$1" "/root/.local/bin/$1" \
                 "/root/.nvm/versions/node/"*/"bin/$1" "/root/.opencode/bin/$1"; do
            [ -x "$c" ] && { echo "$c"; exit 0; }
        done
        exit 1
    ' bash "$1" 2>/dev/null
}

echo
echo "AI Environment Doctor"
echo "====================="
echo

command -v ollama >/dev/null \
    && pass "Ollama installed" \
    || fail "Ollama missing"

proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc 'command -v aider' >/dev/null 2>&1 \
    && pass "Aider installed" \
    || fail "Aider missing"

OC_BIN=$(in_ubuntu_path opencode)
[ -n "$OC_BIN" ] \
    && pass "OpenCode installed" \
    || fail "OpenCode missing"

FB_BIN=$(in_ubuntu_path freebuff)
[ -n "$FB_BIN" ] \
    && pass "Freebuff installed" \
    || fail "Freebuff missing (optional - run 'update-ai')"

command -v proot-distro >/dev/null \
    && pass "proot-distro installed" \
    || fail "proot-distro missing"

command -v llama-cli >/dev/null \
    && pass "llama-cli installed (bench.py)" \
    || fail "llama-cli missing (needed for bench.py)"

command -v llama-bench >/dev/null \
    && pass "llama-bench installed (bench_all.py)" \
    || fail "llama-bench missing (needed for bench_all.py)"

command -v python3 >/dev/null \
    && pass "python3 installed (bench scripts)" \
    || fail "python3 missing (needed for bench scripts)"

proot-distro login "$UBUNTU_DISTRO_NAME" -- true >/dev/null 2>&1 \
    && pass "Ubuntu launches" \
    || fail "Ubuntu failed"

pgrep -f "ollama serve" >/dev/null \
    && pass "Ollama server running" \
    || fail "Ollama server not running"

if [ "$(ollama list 2>/dev/null | awk 'NR>1' | wc -l)" -gt 0 ]; then
    pass "Models installed ($(ollama list 2>/dev/null | awk 'NR>1' | wc -l))"
else
    fail "No models installed (use 'code' > 2) Import GGUF)"
fi

curl -s http://127.0.0.1:11434/api/tags >/dev/null \
    && pass "Ollama API reachable" \
    || fail "Ollama API unreachable"

echo
echo "Versions"
echo "--------"

ollama --version
proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc 'aider --version'
if [ -n "$OC_BIN" ]; then
    proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc "'$OC_BIN' --version"
else
    echo "opencode: not installed"
fi

if [ -n "$FB_BIN" ]; then
    proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc "'$FB_BIN' --version 2>/dev/null || echo 'freebuff: installed (version unknown)'"
else
    echo "freebuff: not installed"
fi

echo
echo "Doctor finished."
