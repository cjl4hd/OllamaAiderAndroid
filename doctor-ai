#!/data/data/com.termux/files/usr/bin/bash

CONFIG_FILE="$HOME/.ai-env.conf"
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
UBUNTU_DISTRO_NAME="${UBUNTU_DISTRO_NAME:-ubuntu}"

GREEN="\033[0;32m"
RED="\033[0;31m"
RESET="\033[0m"

pass() {
    echo -e "${GREEN}✓${RESET} $1"
}

fail() {
    echo -e "${RED}✗${RESET} $1"
}

# Same nested-proot detection as code-ubuntu/adbb-ai. Three signals, because
# a Freebuff/nested session can see Termux's bind-mounted /data/data with no
# PROOT_DISTRO exported (device-observed) — /etc/os-release ID=ubuntu is the
# deciding signal: only the container has it. Running doctor-ai inside proot
# is fine — but the Ubuntu-side checks would otherwise try to proot-distro
# login from within proot and report false "missing" rows. Detect once;
# Ubuntu checks then probe the local rootfs directly instead.
IN_PROOT=false
if [ -n "${PROOT_DISTRO:-}" ] || [ ! -d "/data/data/com.termux" ] || \
   { [ -r /etc/os-release ] && grep -q '^ID=ubuntu' /etc/os-release 2>/dev/null; }; then
    IN_PROOT=true
fi

# Resolve a binary inside Ubuntu without relying on non-interactive PATH:
# nvm/node installers append to ~/.bashrc after Ubuntu's interactive-only
# guard, so 'bash -lc' shells never see npm-installed CLIs.
# Inside proot we ARE that Ubuntu — probe the candidate paths directly
# (proot-distro login cannot nest inside proot). The nvm glob must be
# UNQUOTED to expand across node versions (device-caught: a quoted glob
# segment never matched, hiding OpenCode).
in_ubuntu_path() {
    if [ "$IN_PROOT" = true ]; then
        local c
        for c in "/usr/local/bin/$1" "/usr/bin/$1" "$HOME/.local/bin/$1" \
                 $HOME/.nvm/versions/node/*/bin/$1 "$HOME/.opencode/bin/$1"; do
            [ -x "$c" ] && { echo "$c"; return 0; }
        done
        return 1
    fi
    proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc '
        for c in "/usr/local/bin/$1" "/usr/bin/$1" "/root/.local/bin/$1" \
                 "/root/.nvm/versions/node/"*/"bin/$1" "/root/.opencode/bin/$1"; do
            [ -x "$c" ] && { echo "$c"; exit 0; }
        done
        exit 1
    ' bash "$1" 2>/dev/null
}

# Run a command in the Ubuntu context (proot-distro login, or direct when
# nested). Usage: run_ubuntu 'command string'
run_ubuntu() {
    if [ "$IN_PROOT" = true ]; then
        bash -c "$1" 2>/dev/null
    else
        proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc "$1" 2>/dev/null
    fi
}

echo
echo "AI Environment Doctor"
echo "====================="
echo
if [ "$IN_PROOT" = true ]; then
    echo "(running INSIDE proot Ubuntu - Ubuntu checks probe the local"
    echo " rootfs directly instead of nesting another proot session)"
    echo
fi

# llama.cpp is the primary engine (Ollama retired, Phase 3).
LLAMA_PORT="${LLAMA_SERVER_PORT:-8080}"
command -v llama-server >/dev/null \
    && pass "llama-server installed" \
    || fail "llama-server missing (pkg install llama-cpp)"

run_ubuntu 'command -v aider' >/dev/null 2>&1 \
    && pass "Aider installed" \
    || fail "Aider missing"

OC_BIN=$(in_ubuntu_path opencode)
[ -n "$OC_BIN" ] \
    && pass "OpenCode installed" \
    || fail "OpenCode missing"

FB_BIN=$(in_ubuntu_path freebuff)
[ -n "$FB_BIN" ] \
    && pass "Freebuff installed" \
    || fail "Freebuff missing (optional - run 'update-ai')"

if [ "$IN_PROOT" = true ]; then
    echo "(proot-distro check skipped: nested inside proot)"
else
    command -v proot-distro >/dev/null \
        && pass "proot-distro installed" \
        || fail "proot-distro missing"
fi

command -v llama-cli >/dev/null \
    && pass "llama-cli installed (bench.py)" \
    || fail "llama-cli missing (needed for bench.py)"

# A host-side llama-server is invisible to pgrep from inside proot (the
# container only sees its own /proc) — there the health endpoint is the only
# honest signal; on the host both signals exist.
if [ "$IN_PROOT" = true ]; then
    curl -s -m 3 "http://127.0.0.1:$LLAMA_PORT/health" </dev/null >/dev/null 2>&1 \
        && pass "llama.cpp server running (API :$LLAMA_PORT reachable)" \
        || echo "  (llama.cpp not reachable - start it on the Termux side: 'code' > 5)"
else
    pgrep -x llama-server >/dev/null 2>&1 \
        && pass "llama-server running" \
        || echo "  (llama-server not running - 'code' > 5 starts it)"
    curl -s -m 3 "http://127.0.0.1:$LLAMA_PORT/health" </dev/null >/dev/null 2>&1 \
        && pass "llama.cpp API reachable (:$LLAMA_PORT)" \
        || echo "  (llama.cpp API unreachable - start the server for aider/OpenCode to work)"
fi

# BigMoeOnEdge (Phase 2): optional second engine, built in the Ubuntu clone.
BMOE_BIN=$(in_ubuntu_path bmoe-cli)
[ -n "$BMOE_BIN" ] \
    && pass "bmoe-cli installed" \
    || echo "  (bmoe-cli not found in Ubuntu - optional; build via update-ai's BMoE section)"

command -v llama-bench >/dev/null \
    && pass "llama-bench installed (bench_all.py)" \
    || fail "llama-bench missing (needed for bench_all.py)"

command -v python3 >/dev/null \
    && pass "python3 installed (bench scripts)" \
    || fail "python3 missing (needed for bench scripts)"

if [ "$IN_PROOT" = true ]; then
    pass "Ubuntu launches (native - we ARE in Ubuntu)"
else
    proot-distro login "$UBUNTU_DISTRO_NAME" -- true >/dev/null 2>&1 \
        && pass "Ubuntu launches" \
        || fail "Ubuntu failed"
fi

#Model sources mirror code's config block: android-home/models is primary
#(resolvable from BOTH homes via the android-home symlink), legacy Ollama
#blobs second.
LMDIR=$(find "$HOME/android-home/models" /data/data/com.termux/files/home/android-home/models \
    -maxdepth 1 -name models -type d 2>/dev/null | head -1)
[ -n "$LMDIR" ] || LMDIR="${LLAMA_MODELS_DIR:-$HOME/.llama/models}"
NGGUF=$(find "$LMDIR" -maxdepth 2 -name '*.gguf' 2>/dev/null | wc -l)
NBLOBS=$(find "${OLLAMA_MODELS:-$HOME/.ollama/models}/blobs" -maxdepth 1 -type f -size +100M 2>/dev/null | wc -l)
NTOT=$((NGGUF + NBLOBS))
if [ "$NTOT" -gt 0 ]; then
    pass "Models available ($NTOT: $NGGUF imported + $NBLOBS legacy Ollama blobs)"
else
    fail "No models found (use 'code' > 2 Import GGUF)"
fi

echo
echo "Versions"
echo "--------"

llama-server --version 2>/dev/null | head -1
run_ubuntu 'aider --version'
if [ -n "$OC_BIN" ]; then
    run_ubuntu "'$OC_BIN' --version"
else
    echo "opencode: not installed"
fi

if [ -n "$FB_BIN" ]; then
    run_ubuntu "'$FB_BIN' --version 2>/dev/null || echo 'freebuff: installed (version unknown)'"
else
    echo "freebuff: not installed"
fi

echo
echo "Doctor finished."
