#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Android AI Environment Updater
# Runs in Termux (host), NOT inside proot-distro Ubuntu
# =============================================================================

# --- Config ---
CONFIG_FILE="$HOME/.ai-env.conf"
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"

# --- Defaults (overridable via ~/.ai-env.conf) ---
PYTHON_VERSION="${PYTHON_VERSION:-3.12}"  # Python 3.12: most stable with aider-chat per upstream testing
UBUNTU_DISTRO_NAME="${UBUNTU_DISTRO_NAME:-ubuntu}"  # Consider unique name for managed env
PROJECT_NAME="${PROJECT_NAME:-OllamaAiderAndroid}"

# --- Flags ---
VERBOSE=false
QUIET=false
FORCE=false

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Updates the Android AI development environment (Termux + proot Ubuntu + Ollama + Aider).

Options:
  -v, --verbose    Detailed output
  -q, --quiet      Suppress non-error output
  -f, --force      Skip confirmation prompt
  -h, --help       Show this help

Environment (via ~/.ai-env.conf):
  PYTHON_VERSION       Python version for UV (default: 3.12)
  UBUNTU_DISTRO_NAME   proot-distro name (default: ubuntu)
  PROJECT_NAME         Git project directory name (default: OllamaAiderAndroid)
  PROJECT_DIR          Absolute path to project dir, overrides auto-detection
                        (use this if your clone isn't in one of the usual spots)
  GGUF_DIR             Directory for .gguf model imports
                        (default: /storage/emulated/0/Models)
  OPENCODE             OpenCode install preference: ask (prompt if not installed)
                        or no (never install) (default: ask)
EOF
    exit 0
}

log() { [ "$QUIET" = false ] && echo "$*" >&2; return 0; }
vlog() { [ "$VERBOSE" = true ] && echo "[DEBUG] $*" >&2; return 0; }
err() { echo "ERROR: $*" >&2; }
die() { err "$*"; exit 1; }

# Parse flags
while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--verbose) VERBOSE=true; shift ;;
        -q|--quiet) QUIET=true; shift ;;
        -f|--force) FORCE=true; shift ;;
        -h|--help) usage ;;
        *) die "Unknown option: $1" ;;
    esac
done

# =============================================================================
# Environment Validation
# =============================================================================

# Verify running in Termux host (not inside proot)
if [ -n "${PROOT_DISTRO:-}" ] || [ ! -d "/data/data/com.termux" ]; then
    die "This script must run in Termux (host), not inside proot-distro Ubuntu"
fi

log "Running in Termux (host)"
vlog "DEBUG: About to validate paths"

# =============================================================================
# Dynamic Path Detection with Fallbacks
# =============================================================================

TERMUX_PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
TERMUX_HOME="${HOME:-/data/data/com.termux/files/home}"
UBUNTU_ROOTFS="$TERMUX_PREFIX/var/lib/proot-distro/containers/$UBUNTU_DISTRO_NAME/rootfs"
UBUNTU_HOME="$UBUNTU_ROOTFS/root"
ANDROID_HOME="/storage/emulated/0"
BIN_DIR="$TERMUX_PREFIX/bin"
GGUF_DIR="${GGUF_DIR:-$ANDROID_HOME/Models}"

# Validate critical paths
vlog "DEBUG: Validating TERMUX_PREFIX=$TERMUX_PREFIX"
[ -d "$TERMUX_PREFIX" ] || die "Termux prefix not found: $TERMUX_PREFIX"
vlog "DEBUG: Validating TERMUX_HOME=$TERMUX_HOME"
[ -d "$TERMUX_HOME" ] || die "Termux home not found: $TERMUX_HOME"

log "Paths validated: TERMUX_PREFIX=$TERMUX_PREFIX, TERMUX_HOME=$TERMUX_HOME"

# UBUNTU_ROOTFS/UBUNTU_HOME may legitimately not exist yet on a first run
# (proot-distro install happens later), so these are warnings, not fatal.
[ -d "$UBUNTU_ROOTFS" ] || log "Note: Ubuntu rootfs not found yet at $UBUNTU_ROOTFS (will be installed if needed)"
[ -d "$ANDROID_HOME" ] || log "Warning: Android storage not found at $ANDROID_HOME (grant storage permission with 'termux-setup-storage' if symlinks fail)"

vlog "DEBUG: About to find project dir"

vlog "TERMUX_PREFIX=$TERMUX_PREFIX"
vlog "TERMUX_HOME=$TERMUX_HOME"
vlog "UBUNTU_ROOTFS=$UBUNTU_ROOTFS"
vlog "UBUNTU_HOME=$UBUNTU_HOME"
vlog "ANDROID_HOME=$ANDROID_HOME"
vlog "BIN_DIR=$BIN_DIR"

# =============================================================================
# Project Directory Detection
# =============================================================================

find_project_dir() {
    vlog "DEBUG: find_project_dir called"

    # Explicit override always wins, for clones that live outside the usual spots
    if [ -n "${PROJECT_DIR:-}" ]; then
        vlog "DEBUG: PROJECT_DIR override set, checking $PROJECT_DIR"
        if [ -d "$PROJECT_DIR/.git" ]; then
            vlog "DEBUG: Found .git at override $PROJECT_DIR"
            echo "$PROJECT_DIR"
            return 0
        fi
        vlog "DEBUG: PROJECT_DIR override set but no .git found there"
        return 1
    fi

    local candidates=(
        "$TERMUX_HOME/$PROJECT_NAME"
        "$UBUNTU_HOME/projects/$PROJECT_NAME"
    )

    for dir in "${candidates[@]}"; do
        vlog "DEBUG: Checking $dir"
        if [ -d "$dir/.git" ]; then
            vlog "DEBUG: Found .git at $dir"
            echo "$dir"
            return 0
        fi
    done

    vlog "DEBUG: No .git found in any candidate"
    return 1
}

# Capture output and check return code in one call
PROJECT_DIR_HOST=$(find_project_dir) || {
    if [ -n "${PROJECT_DIR:-}" ]; then
        die "Project directory not found at PROJECT_DIR=$PROJECT_DIR (no .git there)"
    else
        die "Project directory not found. Expected: ~/$PROJECT_NAME or ~/ubuntu-home/projects/$PROJECT_NAME (set PROJECT_DIR in ~/.ai-env.conf to override)"
    fi
}
log "Project directory found: $PROJECT_DIR_HOST"

# =============================================================================
# Confirmation
# =============================================================================

if [ "$FORCE" = false ] && [ "$QUIET" = false ]; then
    cat <<EOF
This will:
  • Pull latest project files (git)
  • Install or update the Ubuntu proot environment ($UBUNTU_DISTRO_NAME)
  • Update Termux packages
  • Set up / update the Python env (Python $PYTHON_VERSION), Ollama, and Aider
  • Optionally install / update OpenCode (only if you choose to)
  • Set up shared storage access and the models directory ($GGUF_DIR)
  • Refresh symlinks (Termux home, Ubuntu home, bin path)

EOF
    read -p "Continue? [Y/n] " ans
    case "$ans" in
        [Nn]*) exit 0 ;;
    esac
fi

# =============================================================================
# Helper Functions
# =============================================================================

run_in_ubuntu() {
    proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc "$1"
}

run_in_ubuntu_safe() {
    local cmd="$1"
    local desc="${2:-command}"
    if ! run_in_ubuntu "$cmd"; then
        err "$desc failed, attempting recovery..."
        run_in_ubuntu "DEBIAN_FRONTEND=noninteractive apt --fix-broken install -y" || die "Package fix failed for $desc"
        run_in_ubuntu "$cmd" || die "$desc failed after recovery"
    fi
}

set_conf() {
    local key="$1"
    local val="$2"
    if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONFIG_FILE"
    else
        echo "${key}=${val}" >> "$CONFIG_FILE"
    fi
}

# =============================================================================
# 1. Git Pull
# =============================================================================

log ""
log "===== Pulling latest from git ====="

if [[ "$PROJECT_DIR_HOST" == "$UBUNTU_ROOTFS"* ]]; then
    log "Repo lives inside proot Ubuntu - pulling via $UBUNTU_DISTRO_NAME"
    IN_UBUNTU_DIR="${PROJECT_DIR_HOST#$UBUNTU_ROOTFS}"
    if proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc "cd '$IN_UBUNTU_DIR' && git pull"; then
        log "Git pull successful"
    else
        err "Git pull failed (continuing anyway)"
    fi
else
    cd "$PROJECT_DIR_HOST"
    if git pull; then
        log "Git pull successful"
    else
        err "Git pull failed (continuing anyway)"
    fi
fi

# =============================================================================
# 2. Termux Packages
# =============================================================================

log ""
log "===== Updating Termux packages ====="
pkg update
pkg upgrade -y || {
    err "pkg upgrade failed, attempting fix..."
    pkg install -f || die "Termux package recovery failed"
}

# =============================================================================
# 3. Proot Ubuntu Environment
# =============================================================================

log ""
log "===== Checking proot Ubuntu environment ($UBUNTU_DISTRO_NAME) ====="

if [ ! -d "$UBUNTU_ROOTFS" ]; then
    log "Ubuntu not found - installing proot-distro + $UBUNTU_DISTRO_NAME..."
    pkg install proot-distro -y
    proot-distro install "$UBUNTU_DISTRO_NAME"
else
    log "$UBUNTU_DISTRO_NAME already installed - updating packages..."
    run_in_ubuntu_safe "
        apt update
        DEBIAN_FRONTEND=noninteractive apt upgrade -y
        apt autoremove -y
        apt autoclean
    " "Ubuntu package update"
fi

# =============================================================================
# 4. Python / UV / Aider (inside Ubuntu)
# =============================================================================

log ""
log "===== Python env / Aider (Python $PYTHON_VERSION) ====="

# Check if aider exists inside Ubuntu
if ! run_in_ubuntu "command -v aider" >/dev/null 2>&1; then
    log "Aider not found - installing UV + Python $PYTHON_VERSION + aider-chat..."
    run_in_ubuntu_safe "
        curl -LsSf https://astral.sh/uv/install.sh | sh
        source ~/.bashrc
        uv python install $PYTHON_VERSION
        uv tool install aider-chat --python $PYTHON_VERSION
        aider --version
    " "Aider initial install"
else
    log "Aider found - upgrading..."
    run_in_ubuntu_safe "
        uv tool upgrade --python $PYTHON_VERSION aider-chat
    " "Aider upgrade"
fi

# =============================================================================
# 5. Shared Storage & Models
# =============================================================================

log ""
log "===== Shared storage & models ====="

if [ ! -f "$CONFIG_FILE" ]; then
    log "Creating default config: $CONFIG_FILE"
    cat > "$CONFIG_FILE" <<EOF
# AI environment config (sourced by update-ai, code, doctor-ai)
PYTHON_VERSION=$PYTHON_VERSION
UBUNTU_DISTRO_NAME=$UBUNTU_DISTRO_NAME
PROJECT_NAME=$PROJECT_NAME
# GGUF_DIR=/storage/emulated/0/Models
# OPENCODE=ask
EOF
fi

if [ ! -L "$TERMUX_HOME/storage" ]; then
    log "Termux shared storage access is not set up (needed for GGUF imports)."
    if [ "$FORCE" = false ] && [ "$QUIET" = false ]; then
        read -p "Run 'termux-setup-storage' now? (Android will ask for permission) [Y/n] " ans
        case "$ans" in
            [Nn]*) err "Skipped - run 'termux-setup-storage' later to enable GGUF imports" ;;
            *)
                termux-setup-storage
                sleep 2
                [ -L "$TERMUX_HOME/storage" ] || err "Storage permission not granted - imports will not work"
                ;;
        esac
    else
        err "Run 'termux-setup-storage' (Android will prompt for permission), then re-run"
    fi
else
    log "Shared storage access OK"
fi

if [ ! -d "$GGUF_DIR" ]; then
    log "Models directory not found: $GGUF_DIR"
    if [ "$FORCE" = false ] && [ "$QUIET" = false ]; then
        read -p "Create $GGUF_DIR now? [Y/n] " ans
        case "$ans" in
            [Nn]*) err "Skipped - create it later and place .gguf files there" ;;
            *)
                mkdir -p "$GGUF_DIR" 2>/dev/null && log "Created $GGUF_DIR" \
                    || err "Could not create $GGUF_DIR (is storage permission granted?)"
                ;;
        esac
    else
        mkdir -p "$GGUF_DIR" 2>/dev/null || err "Could not create $GGUF_DIR (is storage permission granted?)"
    fi
fi

if [ -d "$GGUF_DIR" ] && [ -z "$(ls -A "$GGUF_DIR" 2>/dev/null)" ]; then
    log "Models directory is empty: $GGUF_DIR"
    if [ "$FORCE" = false ] && [ "$QUIET" = false ]; then
        read -p "Add .gguf files there, then press Enter (or n to skip): " ans
        case "$ans" in
            [Nn]*) log "Skipped - import models later via 'code' > 2) Import GGUF" ;;
            *)
                if [ -n "$(ls -A "$GGUF_DIR" 2>/dev/null)" ]; then
                    log "Models detected: $GGUF_DIR"
                else
                    log "Still empty - import models later via 'code' > 2) Import GGUF"
                fi
                ;;
        esac
    else
        log "Place .gguf model files there and import them via 'code'"
    fi
fi

# =============================================================================
# 6. Ollama (on Host)
# =============================================================================

log ""
log "===== Ollama ====="

if ! command -v ollama >/dev/null 2>&1; then
    log "Ollama not found - installing..."
    pkg install ollama -y
else
    log "Ollama found - checking for updates..."
    pkg upgrade ollama -y
fi

# =============================================================================
# 7. OpenCode (inside Ubuntu, optional)
# =============================================================================

log ""
log "===== OpenCode (inside Ubuntu) ====="

if run_in_ubuntu "command -v opencode" >/dev/null 2>&1; then
    log "OpenCode found - upgrading..."
    run_in_ubuntu_safe "opencode upgrade" "OpenCode upgrade"
elif [ "${OPENCODE:-ask}" = "no" ]; then
    log "OpenCode not installed (install disabled in $CONFIG_FILE)"
elif [ "$FORCE" = true ] || [ "$QUIET" = true ]; then
    log "OpenCode not installed - skipping (run interactively to be asked)"
else
    read -p "OpenCode not installed. Install it now? [y]es / [n]o / [d]on't ask again: " ans
    case "$ans" in
        y|Y)
            log "Installing OpenCode..."
            run_in_ubuntu_safe "
                curl -fsSL https://opencode.ai/install | bash
                grep -q 'OPENCODE_DISABLE_AUTOUPDATE' ~/.bashrc 2>/dev/null || echo 'export OPENCODE_DISABLE_AUTOUPDATE=true' >> ~/.bashrc
                ~/.opencode/bin/opencode --version
            " "OpenCode install"
            ;;
        d|D)
            set_conf "OPENCODE" "no"
            log "Saved: will not ask about OpenCode again (edit $CONFIG_FILE to re-enable)"
            ;;
        *) log "Skipping OpenCode install" ;;
    esac
fi

# =============================================================================
# 8. Symlinks
# =============================================================================

log ""
log "===== Setting up symlinks ====="

# Ensure Ubuntu home exists
[ -d "$UBUNTU_HOME" ] || die "Ubuntu home not found: $UBUNTU_HOME (run proot-distro install first)"

# Termux home -> Ubuntu home + Android storage
ln -sfn "$UBUNTU_HOME" "$TERMUX_HOME/ubuntu-home"
ln -sfn "$ANDROID_HOME" "$TERMUX_HOME/android-home"

# Ubuntu home -> Termux home + Android storage (using $ANDROID_HOME consistently)
ln -sfn "$TERMUX_HOME" "$UBUNTU_HOME/termux-home"
ln -sfn "$ANDROID_HOME" "$UBUNTU_HOME/android-home"

# Bin links for update-ai / doctor-ai
chmod +x "$PROJECT_DIR_HOST/ubuntu" "$PROJECT_DIR_HOST/code" "$PROJECT_DIR_HOST/update-ai" "$PROJECT_DIR_HOST/doctor-ai"
ln -sfn "$PROJECT_DIR_HOST/code" "$BIN_DIR/code"
ln -sfn "$PROJECT_DIR_HOST/update-ai" "$BIN_DIR/update-ai"
ln -sfn "$PROJECT_DIR_HOST/doctor-ai" "$BIN_DIR/doctor-ai"
ln -sfn "$PROJECT_DIR_HOST/ubuntu" "$BIN_DIR/ubuntu"

log "Symlinks updated"

# =============================================================================
# 9. Version Summary
# =============================================================================

log ""
log "===== Versions ====="
log "Ollama: $(ollama --version 2>/dev/null || echo 'not installed')"
log "Aider:  $(run_in_ubuntu 'aider --version' 2>/dev/null || echo 'not installed')"
log "OpenCode: $(run_in_ubuntu 'opencode --version' 2>/dev/null || echo 'not installed')"
run_in_ubuntu 'echo "Ubuntu:"; . /etc/os-release; echo "$PRETTY_NAME"' 2>/dev/null || log "Ubuntu: version unknown"

log ""
log "✔ Update complete."
