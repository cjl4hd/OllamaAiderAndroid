#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# code-ubuntu — the dev-side half of the `code` launcher. Runs INSIDE proot
# Ubuntu only (refuses to run on the Termux host), and talks to the host's
# Ollama over loopback HTTP. `code` (Termux) owns host-only things: ollama
# CLI chat/imports, package updates, the server itself. Everything that is
# "inside Ubuntu" by nature lives here and works BOTH when `code` drops into
# this menu and when you're already in an `ubuntu` shell and just type
# `code-ubuntu`.
#
# Subcommands: aider | opencode | freebuff | regen-oc | mem | status | bmoe
# No args: interactive menu.
#
# Config: ~/.ai-env.conf is reached through the termux-home symlink created
# by update-ai (one config file repo-wide, per AGENTS.md rule 2):
#   OLLAMA_CONTEXT_LENGTH, ADB_AI_AUTO_CLEAN (ask|always|never),
#   ADB_AI_LOW_RAM_GB, PROJECTS_DIR,
#   BMOE_CACHE_MB, BMOE_THREADS, BMOE_IO_THREADS (bmoe-cli tunables)
# State: ~/.config/code-ubuntu/last_model, ~/.config/code-ubuntu/last_bmoe_model
# =============================================================================

if [ ! -r /etc/os-release ] || ! grep -q '^ID=ubuntu' /etc/os-release; then
    # die()/log()/err() are defined further down; the guard runs first, so
    # inline the error (device lesson: the old call silently no-op'd).
    if [ -d "/data/data/com.termux" ]; then
        echo "ERROR: This runs INSIDE proot Ubuntu - it is invoked for you by 'code' (option 8), or from an 'ubuntu' shell" >&2
        exit 1
    fi
    echo "ERROR: code-ubuntu must run inside a proot Ubuntu container" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$HOME/.config/code-ubuntu"
LAST_FILE="$STATE_DIR/last_model"

# --- Config (Termux's ~/.ai-env.conf via the termux-home symlink) ---
[ -f "$HOME/termux-home/.ai-env.conf" ] && \
    # shellcheck disable=SC1090
    . "$HOME/termux-home/.ai-env.conf"
# llama.cpp server: THE engine (Ollama retired, Phase 3). Same port the
# Termux side's 'code' menu 5 uses.
LLAMA_URL="${LLAMA_URL:-http://127.0.0.1:8080}"
LLAMA_CONTEXT_LENGTH="${LLAMA_CONTEXT_LENGTH:-8192}"
ADB_AI_AUTO_CLEAN="${ADB_AI_AUTO_CLEAN:-ask}"
ADB_AI_LOW_RAM_GB="${ADB_AI_LOW_RAM_GB:-4}"
PROJECTS_DIR="${PROJECTS_DIR:-$HOME/projects}"
# BMoE (bmoe-cli, the flash-streamed MoE engine): cache/thread tunables and
# an absolute-path override for tests — the launcher never PATH-exports.
BMOE_CACHE_MB="${BMOE_CACHE_MB:-2000}"
BMOE_THREADS="${BMOE_THREADS:-8}"
BMOE_IO_THREADS="${BMOE_IO_THREADS:-4}"

# Every API call from this side goes through curl; a proot rootfs without it
# looks exactly like "server unreachable". Say so once, up front.
command -v curl >/dev/null 2>&1 || \
    err "curl is not installed in Ubuntu - llama.cpp calls will fail. Run 'update-ai' (Termux side) to install it."

usage() {
    cat <<EOF
Usage: code-ubuntu [COMMAND]

The Ubuntu-side dev menu. Works standalone in an 'ubuntu' shell, or via
'code' (Termux) option 8.

Commands:
  (none) | menu    Interactive menu (aider / opencode / freebuff / regen-oc /
                   android memory / BMoE stream-chat / status)
  aider            Model picker -> project picker -> aider
  opencode         Model picker (incl. cloud) -> project picker -> opencode
  freebuff         Project picker -> freebuff (cloud models)
  regen-oc         Regenerate ~/.config/opencode/opencode.json from the
                   current llama.cpp model list
  mem              Android memory menu (delegates to adb-ai)
  bmoe             BMoE stream-chat on a GGUF from the shared models dir
                   (MoE models bigger than RAM; args pass to bmoe-cli)
  status           llama.cpp + memory status
Options:
  -f, --force      regen-oc: overwrite without asking
  -h, --help       Show this help
EOF
    exit 0
}

# =============================================================================
# Helpers
# =============================================================================
log()  { echo "$*"; }
err()  { echo "ERROR: $*" >&2; }
die()  { err "$*"; exit 1; }

# llama.cpp API (OpenAI-compatible). Every call: timeout with hard kill +
# stdin /dev/null (device lesson from adb-ai: nothing may hold the caller's
# pipe or block forever).
lapi() { # path
    timeout -k 2 10 curl -s "$LLAMA_URL$1" </dev/null 2>/dev/null || true
}
lapi_ok() { [ -n "$(lapi /health)" ]; }

# Model table from llama-server's /v1/models. NOTE (device-verified):
# llama-server currently serves the model's FILE NAME (the blob hash, or the
# --alias value) as its id, not a friendly tag like Ollama does. The Termux
# launcher passes --alias per model; from here we just surface what it says.
load_models_llama() {
    local j t
    j=$(lapi /v1/models)
    if [ -z "$j" ]; then
        LMODELS=(); return 1
    fi
    t=$(mktemp)
    printf '%s' "$j" | grep -oE '"id": *"[^"]*"' | sed 's/.*"id": *"//; s/"$//' > "$t"
    mapfile -t LMODELS < "$t"
    rm -f "$t"
    [ ${#LMODELS[@]} -gt 0 ]
}

# Free RAM in GB from /proc/meminfo (Android kernels expose MemAvailable).
free_ram_gb() {
    awk '/MemAvailable/{printf "%.1f", $2/1048576; exit}' /proc/meminfo 2>/dev/null
}

# =============================================================================
# Project picker (model pickers live in the launchers — llama.cpp has no
# per-model metadata endpoint, and the id already says which file it serves)
# =============================================================================

select_project() {
    log "Projects:"
    local dirs=("$PROJECTS_DIR"/*/)
    if [ ! -d "${dirs[0]:-}" ]; then
        die "No projects found in $PROJECTS_DIR"
    fi
    echo " 0) Cancel"
    local dir
    select dir in "${dirs[@]}"; do
        case "$REPLY" in 0) return 130 ;; esac
        [ -n "$dir" ] && { PROJECT_NAME=$(basename "${dir%/}"); break; }
    done
    return 0
}

# =============================================================================
# Pre-launch quick clean (moved from `code`; native here — /proc and adb-ai
# are local). Never blocks a launch: any failure just continues.
# =============================================================================

adb_ai_bin() {
    if command -v adb-ai >/dev/null 2>&1; then
        command -v adb-ai
    elif [ -x "$SCRIPT_DIR/adb-ai" ]; then
        echo "$SCRIPT_DIR/adb-ai"
    else
        return 1
    fi
}

maybe_quick_clean() {
    local mode="${ADB_AI_AUTO_CLEAN:-ask}"
    [ "$mode" = "never" ] && return 0
    local before after bin
    before=$(free_ram_gb)
    case "${before:-}" in ''|*[!0-9.]*) return 0 ;; esac
    awk -v b="$before" -v t="$ADB_AI_LOW_RAM_GB" 'BEGIN{exit !(b+0<t+0)}' || return 0
    if [ "$mode" = "ask" ]; then
        local a
        read -rp "Free RAM ${before}GB is low - quick-clean Android first? [Y/n] " a
        case "$a" in [Nn]*) return 0 ;; esac
    fi
    bin=$(adb_ai_bin) || { err "RAM low but adb-ai not found - run 'update-ai'"; return 0; }
    "$bin" mem --t1 --force --quiet >/dev/null 2>&1 || return 0
    after=$(free_ram_gb)
    [ -n "$after" ] && log "Android memory cleaned: ${before}GB -> ${after}GB free"
    return 0
}

# =============================================================================
# Launches. Plain: cd + binary. opencode gets an absolute path WITHOUT any
# PATH export (device-bisect lesson: the export wedges its TUI). freebuff's
# npm shim is '#!/usr/bin/env node' which cannot resolve node in a
# non-interactive shell — run the shim via node's absolute path instead.
# =============================================================================

find_node() {
    if command -v node >/dev/null 2>&1; then command -v node; return 0; fi
    local n
    n=$(ls -d "$HOME"/.nvm/versions/node/*/bin/node 2>/dev/null | tail -1)
    [ -n "$n" ] && { echo "$n"; return 0; }
    return 1
}

launch_aider() {
    maybe_quick_clean
    # llama.cpp is the primary engine (Ollama retired, Phase 3). No engine
    # sub-choice: the server must be up on the Termux side (menu 5 there).
    lapi_ok || die "llama.cpp server not reachable at $LLAMA_URL - start it from the Termux side ('code' > 5)."
    load_models_llama || { err "llama.cpp server is up but lists no models."; return 1; }
    # Picker shaped like select_model, but over LMODELS (no meta API on
    # llama-server; the id already says which file is loaded).
    local li lc last mark
    last="$(cat "$LAST_FILE" 2>/dev/null || true)"
    log "llama.cpp models:"
    for li in "${!LMODELS[@]}"; do
        mark=""
        [ "${LMODELS[$li]}" = "$last" ] && mark=" ⭐"
        printf "%2d) %-45s%s\n" $((li+1)) "${LMODELS[$li]}" "$mark"
    done
    echo " 0) Cancel"
    read -rp "Choose model [1]: " lc
    lc=${lc:-1}
    case "$lc" in ''|*[!0-9]*) lc=1 ;; esac
    [ "$lc" -eq 0 ] && return 130
    [ "$lc" -lt 1 ] && lc=1
    [ "$lc" -gt ${#LMODELS[@]} ] && lc=${#LMODELS[@]}
    MODEL="${LMODELS[$((lc-1))]}"
    mkdir -p "$STATE_DIR"
    echo "$MODEL" > "$LAST_FILE"
    select_project || return 0
    cd "$PROJECTS_DIR/$PROJECT_NAME"
    # OPENAI_API_KEY must be set even for a local server (litellm refuses
    # to authenticate without one, device-verified); OPENAI_API_BASE is
    # belt-and-braces beside --openai-api-base for aider's litellm layer.
    OPENAI_API_KEY="${OPENAI_API_KEY:-dummy-local-llama}"
    export OPENAI_API_KEY OPENAI_API_BASE="$LLAMA_URL/v1"
    exec aider --model "openai/$MODEL" --openai-api-base "$LLAMA_URL/v1" \
        --openai-api-key "$OPENAI_API_KEY" \
        --timeout 300
}

launch_opencode() {
    local oc
    oc=$(command -v opencode || true)
    [ -z "$oc" ] && [ -x "$HOME/.opencode/bin/opencode" ] && oc="$HOME/.opencode/bin/opencode"
    [ -z "$oc" ] && die "OpenCode is not installed - run 'update-ai'"
    maybe_quick_clean
    # llama.cpp provider config; OpenCode's cloud entry stays as the escape
    # hatch when the phone is too slow for fat agent prompts.
    regen_oc_if_missing llama || die "llama.cpp server lists no models"
    load_models_llama || return 1
    local li lc
    log "llama.cpp models:"
    for li in "${!LMODELS[@]}"; do
        printf "%2d) %-45s\n" $((li+1)) "${LMODELS[$li]}"
    done
    if lapi_ok; then
        log "$(printf '%2d) ☁ OpenCode cloud (its default model)' $((${#LMODELS[@]}+1)))"
    fi
    echo " 0) Cancel"
    read -rp "Choose model [1]: " lc
    lc=${lc:-1}
    case "$lc" in ''|*[!0-9]*) lc=1 ;; esac
    [ "$lc" -eq 0 ] && return 130
    [ "$lc" -lt 1 ] && lc=1
    if [ "$lc" -gt ${#LMODELS[@]} ]; then
        MODEL="__CLOUD__"
    else
        MODEL="${LMODELS[$((lc-1))]}"
    fi
    select_project || return 0
    cd "$PROJECTS_DIR/$PROJECT_NAME"
    if [ "$MODEL" = "__CLOUD__" ]; then
        exec "$oc"
    fi
    exec "$oc" --model "llamacpp/$MODEL"
}

launch_freebuff() {
    local fb node
    fb=$(command -v freebuff || true)
    if [ -z "$fb" ]; then
        # npm global bin may not be on this shell's PATH; probe the usual dir
        fb=$(ls "$HOME"/.nvm/versions/node/*/bin/freebuff 2>/dev/null | tail -1)
    fi
    [ -z "$fb" ] && die "Freebuff is not installed - run 'update-ai'"
    node=$(find_node) || die "node is not installed in Ubuntu - run 'update-ai'"
    select_project || return 0
    cd "$PROJECTS_DIR/$PROJECT_NAME"
    exec "$node" "$fb"
}

# =============================================================================
# OpenCode config (moved from `code`; writes the Ubuntu home natively — no
# more reconstructing the rootfs path from Termux).
# =============================================================================

# Write ~/.config/opencode/opencode.json from the installed Ollama models
# (OpenAI-compatible provider). Schema requires limit.output alongside
# limit.context; output is capped at 4096 (or ctx, if smaller).
# ARG: "llama" generates a second provider block named "llamacpp" pointing at
# the llama.cpp server instead — same schema, same limit rules.
generate_oc_config() {
    # llama.cpp is the only local provider (Ollama retired, Phase 3). Schema
    # requires limit.output alongside limit.context; output capped at 4096.
    local i comma cap
    cap=$(( LLAMA_CONTEXT_LENGTH > 4096 ? 4096 : LLAMA_CONTEXT_LENGTH ))
    load_models_llama || return 1
    [ ${#LMODELS[@]} -eq 0 ] && return 1
    mkdir -p "$HOME/.config/opencode"
    local dest="$HOME/.config/opencode/opencode.json"
    {
        printf '{\n  "$schema": "https://opencode.ai/config.json",\n  "provider": {\n    "llamacpp": {\n      "npm": "@ai-sdk/openai-compatible",\n      "name": "llama.cpp",\n      "options": {\n        "baseURL": "%s/v1"\n      },\n      "models": {\n' "$LLAMA_URL"
        for i in "${!LMODELS[@]}"; do
            comma=","
            [ "$i" -eq $((${#LMODELS[@]}-1)) ] && comma=""
            printf '        "%s": {"name": "%s", "limit": {"context": %s, "output": %s}}%s\n' \
                "${LMODELS[$i]}" "${LMODELS[$i]}" "$LLAMA_CONTEXT_LENGTH" "$cap" "$comma"
        done
        printf '      }\n    }\n  }\n}\n'
    } > "$dest" 2>/dev/null || return 1
    log "Generated OpenCode llama.cpp provider config (~/.config/opencode/opencode.json)"
    return 0
}

# ARG passed through to generate_oc_config: "llama" (default) = llamacpp.
regen_oc_if_missing() {
    [ -f "$HOME/.config/opencode/opencode.json" ] && return 0
    generate_oc_config "$1"
}

cmd_regen_oc() {
    local dest="$HOME/.config/opencode/opencode.json"
    if [ -f "$dest" ] && [ "$FORCE" != true ]; then
        local a
        read -rp "Overwrite existing ~/.config/opencode/opencode.json? [y/N] " a
        case "$a" in [Yy]*) ;; *) log "Aborted."; return 1 ;; esac
    fi
    generate_oc_config llama || die "No models to register - import one first ('code' > 2) Import GGUF)"
}

# =============================================================================
# Status + mem delegation
# =============================================================================

cmd_status() {
    # Mirrors code's status_banner (kept in sync): same layout.
    local fr lm low
    fr=$(free_ram_gb)
    echo "====================================="
    echo " Ubuntu Dev Environment"
    echo "====================================="
    # llama.cpp is the primary engine (Ollama retired, Phase 3).
    local lm=""
    if lapi_ok; then
        echo "llama.cpp : Running"
        lm=$(lapi /v1/models | grep -oE '"id": *"[^"]*"' | head -1 | sed 's/.*"id": *"//; s/"//')
        [ -n "$lm" ] && echo "            loaded: $lm"
    else
        echo "llama.cpp : Not running (start it on the Termux side: 'code' > 5)"
    fi
    echo "Ctx     : $LLAMA_CONTEXT_LENGTH"
    if [ -n "$fr" ]; then
        low=""
        if awk -v f="$fr" -v t="$ADB_AI_LOW_RAM_GB" 'BEGIN{exit !(f+0<t+0)}'; then low="  ** LOW (quick clean: menu 5, adb-ai)"; fi
        echo "FreeRAM : ${fr}GB${low}"
    else
        echo "FreeRAM : ?GB"
    fi
    echo
    return 0
}

cmd_mem() {
    local bin
    bin=$(adb_ai_bin) || die "adb-ai not found - run 'update-ai' (or git pull the repo in Ubuntu)"
    # No exec: from the menu we want to come back after adb-ai exits.
    "$bin" "$@"
}

# =============================================================================
# BMoE (bmoe-cli): the second engine — runs MoE models LARGER than RAM by
# streaming expert weights from flash. A CLI with its own chat loop, NOT an
# HTTP server, so this works with llama-server down too. Dense models are a
# poor fit here: they load fully into RAM. Flags below are the upstream
# README's recommended starting set; anything after them (REST args) is
# passed through untouched, so a tunable in ~/.ai-env.conf only needs to
# differ — no code edit. Resolve the binary by ABSOLUTE PATH, never a PATH
# export (rule 9: the export prefix wedged opencode's TUI on device).
# State: ~/.config/code-ubuntu/last_bmoe_model remembers your last pick.
# =============================================================================

bmoe_bin(){
    local c
    for c in "${BMOE_BIN:-}" /usr/local/bin/bmoe-cli /usr/local/lib/bmoe/bmoe-cli; do
        [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
    done
    return 1
}

# The shared models dir, resolvable from this home (same source list as
# llama.cpp: LLAMA_MODELS_DIR config first, then the android-home symlink).
bmoe_models_dir(){
    local d
    for d in "${LLAMA_MODELS_DIR:-$HOME/android-home/models}" "$HOME/android-home/models"; do
        [ -d "$d" ] && { echo "$d"; return 0; }
    done
    return 1
}

launch_bmoe(){
    local bin dir pick i last mark
    bin=$(bmoe_bin) || { err "bmoe-cli not installed - run 'update-ai' (Termux side, BigMoeOnEdge section)"; return 1; }
    dir=$(bmoe_models_dir) || die "No models dir found in Ubuntu (expected $HOME/android-home/models)"
    maybe_quick_clean
    # Temp file, not process substitution (same /dev/fd proot lesson the
    # rest of this file already encodes).
    local t
    t=$(mktemp)
    find "$dir" -maxdepth 1 -name "*.gguf" | sort > "$t"
    mapfile -t BL < "$t"
    rm -f "$t"
    [ ${#BL[@]} -gt 0 ] || { err "No .gguf files in $dir - import one via 'code' menu 2 (Termux side)"; return 1; }
    last="$(cat "$STATE_DIR/last_bmoe_model" 2>/dev/null || true)"
    log "MoE stream-chat models (any MoE gguf; dense = full RAM):"
    for i in "${!BL[@]}"; do
        mark=""
        [ "${BL[i]}" = "$last" ] && mark=" ⭐"
        printf "%2d) %-45s%s\n" $((i+1)) "$(basename "${BL[i]}")" "$mark"
    done
    echo " 0) Cancel"
    read -rp "Stream-chat on [1]: " pick || pick=1
    pick=${pick:-1}
    case "$pick" in ''|*[!0-9]*) pick=1 ;; esac
    [ "$pick" -eq 0 ] && return 130
    [ "$pick" -lt 1 ] && pick=1
    [ "$pick" -gt ${#BL[@]} ] && pick=${#BL[@]}
    MFILE="${BL[$((pick-1))]}"
    mkdir -p "$STATE_DIR"
    echo "$MFILE" > "$STATE_DIR/last_bmoe_model"
    log "Launching bmoe-cli on $(basename "$MFILE") (ctx tunables: BMOE_CACHE_MB/CACHE_MB etc in ~/.ai-env.conf)"
    # exec: this chat IS the session (same shape as launch_aider).
    exec "$bin" -m "$MFILE" \
        --moe-stream --overlap --dense-weights anon \
        --cache-mb "$BMOE_CACHE_MB" \
        --io-threads "$BMOE_IO_THREADS" \
        -t "$BMOE_THREADS" \
        --chatml --no-think "$@"
}

# =============================================================================
# Menu + dispatch
# =============================================================================

menu() {
    while true; do
        cmd_status
        echo "1) Aider"
        echo "2) OpenCode"
        echo "3) Freebuff"
        echo "4) Regen OpenCode Config"
        echo "5) Android Memory (adb-ai)"
        echo "6) BMoE stream-chat (MoE models bigger than RAM)"
        echo "q) Back"
        local c
        # read || break: EOF (Ctrl-D) must quit cleanly, not die rc=1 via set -e.
        read -rp "Choice: " c || break
        case "$c" in
            # Guarded calls: launches can legitimately return non-zero
            # (picker cancelled = 130) and that must land back on the menu,
            # not kill the script under set -e.
            1) launch_aider || true ;;
            2) launch_opencode || true ;;
            3) launch_freebuff || true ;;
            4) cmd_regen_oc || true ;;
            5) cmd_mem || true ;;
            6) launch_bmoe || true ;;
            q|Q|"") break ;;
        esac
    done
}

CMD="menu"
FORCE=false
REST=()
if [ $# -gt 0 ]; then
    case "$1" in
        -h|--help) usage ;;
        aider|opencode|freebuff|regen-oc|mem|status|bmoe|menu) CMD="$1"; shift ;;
        -f|--force) FORCE=true; shift ;;
        -*) die "Unknown option: $1 (try --help)" ;;
        *) die "Unknown command: $1 (try --help)" ;;
    esac
fi
while [ $# -gt 0 ]; do
    case "$1" in
        -f|--force) FORCE=true ;;
        -h|--help) usage ;;
        *) REST+=("$1") ;;
    esac
    shift
done

case "$CMD" in
    menu)     menu ;;
    aider)    launch_aider ;;
    opencode) launch_opencode ;;
    freebuff) launch_freebuff ;;
    regen-oc) cmd_regen_oc ;;
    mem)      if [ ${#REST[@]} -gt 0 ]; then cmd_mem "${REST[@]}"; else cmd_mem; fi ;;
    bmoe)     if [ ${#REST[@]} -gt 0 ]; then launch_bmoe "${REST[@]}"; else launch_bmoe; fi ;;
    status)   cmd_status ;;
esac
