#!/data/data/com.termux/files/usr/bin/bash
set -e

CONFIG_FILE="$HOME/.ai-env.conf"
if [ ! -f "$CONFIG_FILE" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    echo "No $CONFIG_FILE found - running first-time setup via update-ai..."
    "$SCRIPT_DIR/update-ai" || exit 1
    [ -f "$CONFIG_FILE" ] || { echo "Setup did not complete - $CONFIG_FILE not created. Run 'update-ai' manually."; exit 1; }
fi
source "$CONFIG_FILE"

UBUNTU_DISTRO_NAME="${UBUNTU_DISTRO_NAME:-ubuntu}"
GGUF_DIR="${GGUF_DIR:-$HOME/storage/shared/Models}"

CONFIG_DIR="$HOME/.config/code"
LAST_FILE="$CONFIG_DIR/last_model"
TARGET_DIR="$PREFIX/var/lib/proot-distro/containers/$UBUNTU_DISTRO_NAME/rootfs/root/projects"

mkdir -p "$CONFIG_DIR"

[ -d "$HOME/storage" ] || echo "Warning: shared storage not set up - GGUF import will fail (run 'update-ai')"

#Parameters to optimize for S26
#Force flahs attention, mandatory to unlock kv cache quantization
export OLLAMA_FLASH_ATTENTION=1

#Compress attention vectors to 8 bit int
export OLLAMA_KV_CACHE_TYPE=q8_0

#Ensure only 1 model used at a time
export OLLAMA_MAX_LOADED_MODELS=1

#Single request slot: Ollama's default (4) multiplies the KV cache 4x, which
#alone can push a 7b model past what the phone can hold. One user, one request
#at a time - override via OLLAMA_NUM_PARALLEL in ~/.ai-env.conf.
export OLLAMA_NUM_PARALLEL="${OLLAMA_NUM_PARALLEL:-1}"

#Default context window for requests that don't set num_ctx. OpenCode's agent
#loop wants 64k+, but phone RAM with q8_0 KV cache realistically caps lower.
#Override via OLLAMA_CONTEXT_LENGTH in ~/.ai-env.conf.
export OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-16384}"

#Keep the last-used model resident. Ollama's default is 5m, and on a phone a
#cold reload costs minutes - far worse than holding one model in idle RAM.
#Override via OLLAMA_KEEP_ALIVE in ~/.ai-env.conf ("-1" forever, "0" unload
#immediately, e.g. 30m if a big model squeezes the phone).
export OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:--1}"

#How long Ollama waits for a cold model load before giving up (default 5m).
#Phone flash + big models have landed right at that edge; raise the headroom.
#Override via OLLAMA_LOAD_TIMEOUT in ~/.ai-env.conf.
export OLLAMA_LOAD_TIMEOUT="${OLLAMA_LOAD_TIMEOUT:-15m}"

# num_ctx 4096, num_predict 4096, num_thread 4, temperature 0.5 are model options, require 
#ollama create <model> -f ./Modelfile

start_ollama() {
if ! pgrep -f "ollama serve" >/dev/null; then
 echo "Starting Ollama..."
 nohup ollama serve >/dev/null 2>&1 &
 sleep 3
fi
}

#Resolve a binary inside proot Ubuntu without relying on the login shell's
#PATH: nvm/node installers append to ~/.bashrc AFTER Ubuntu's interactive-only
#guard, so non-interactive 'bash -lc' never sees them. Check the standard PATH
#plus the known install dirs. Prints the absolute path, empty if not found.
ubuntu_which(){
proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc '
for c in "/usr/local/bin/$1" "/usr/bin/$1" "/root/.local/bin/$1" "/root/.nvm/versions/node/"*/"bin/$1" "/root/.opencode/bin/$1"; do
 [ -x "$c" ] && { echo "$c"; exit 0; }
done
exit 1
' bash "$1" 2>/dev/null
}

status() {
COUNT=$(ollama list | awk 'NR>1'|wc -l)
LAST=$(cat "$LAST_FILE" 2>/dev/null || echo "None")
[ "$LAST" = "__CLOUD__" ] && LAST="☁ cloud (opencode)"
LOADED=$(ollama ps 2>/dev/null | awk 'NR>1{print $1; exit}')
[ -z "$LOADED" ] && LOADED="none"
echo "====================================="
echo " AI Development Environment"
echo "====================================="
if pgrep -f "ollama serve" >/dev/null; then
 echo "Ollama : Running"
else
 echo "Ollama : Stopped"
fi
echo "Models  : $COUNT"
echo "Last    : $LAST"
echo "Loaded  : $LOADED"
echo "Ctx     : $OLLAMA_CONTEXT_LENGTH"
echo
}

select_model(){
#Optional "cloud" arg appends an OpenCode-cloud entry after the local models
#(opencode only; aider/chat are local-only). Cloud is kept LAST so the default
#choice stays the first local model. Sentinel __CLOUD__ = launch opencode bare
#(its own default model, e.g. nemotron-3-ultra-free).
local with_cloud="${1:-}"
local last="$(cat "$LAST_FILE" 2>/dev/null)"
mapfile -t MODELS < <(ollama list|awk 'NR>1{print $1}')
[ ${#MODELS[@]} -eq 0 ] && [ -z "$with_cloud" ] && { echo "No models."; exit 1; }
echo "Installed models:"
for i in "${!MODELS[@]}"; do
 mark=""
 [ "${MODELS[$i]}" = "$(cat "$LAST_FILE" 2>/dev/null)" ] && mark=" ⭐"
 printf "%2d) %s%s
" $((i+1)) "${MODELS[$i]}" "$mark"
done
local n=${#MODELS[@]}
if [ -n "$with_cloud" ]; then
 echo "    -- cloud --"
 [ "$last" = "__CLOUD__" ] && mark=" ⭐" || mark=""
 printf "%2d) ☁ OpenCode cloud (its default model)%s\n" $((n+1)) "$mark"
fi
read -p "Choose model [1]: " c
c=${c:-1}
case "$c" in ''|*[!0-9]*) c=1 ;; esac
[ "$c" -lt 1 ] && c=1
[ "$c" -gt "$n" ] && [ -z "$with_cloud" ] && c=1
if [ "$c" -gt "$n" ] && [ -n "$with_cloud" ]; then
 MODEL="__CLOUD__"
else
 MODEL="${MODELS[$((c-1))]}"
fi
echo "$MODEL" > "$LAST_FILE"
}

select_project(){
echo "Projects:"
local dirs=("$TARGET_DIR"/*/)
if [ ${#dirs[@]} -eq 0 ] || [ ! -d "${dirs[0]}" ]; then
 echo "No projects found in $TARGET_DIR"
 exit 1
fi
select dir in "${dirs[@]}"; do
 [ -n "$dir" ] && { PROJECT_NAME=$(basename "${dir%/}"); break; }
done
}

launch(){
select_model
select_project
proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc "cd projects/$PROJECT_NAME && aider --model ollama_chat/$MODEL"
}

chat(){
select_model
ollama run "$MODEL"
}

#Write ~/.config/opencode/opencode.json inside Ubuntu from the installed
#Ollama models (OpenAI-compatible provider), so OpenCode can select them via
#--model ollama/<name>. Always overwrites.
#Returns 0 if the config was written, non-zero otherwise (no models / write failure).
generate_opencode_config(){
mapfile -t MODELS < <(ollama list|awk 'NR>1{print $1}')
[ ${#MODELS[@]} -eq 0 ] && return 1
#OpenCode's schema requires limit.output alongside limit.context. Cap output
#at 4096 tokens (or the context window, if smaller) - a large max_output on a
#phone-sized context risks runaway generation.
OUTPUT_CAP=$(( OLLAMA_CONTEXT_LENGTH > 4096 ? 4096 : OLLAMA_CONTEXT_LENGTH ))
proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc 'mkdir -p "$HOME/.config/opencode"'
DEST="$PREFIX/var/lib/proot-distro/containers/$UBUNTU_DISTRO_NAME/rootfs/root/.config/opencode/opencode.json"
{
printf '{\n  "$schema": "https://opencode.ai/config.json",\n  "provider": {\n    "ollama": {\n      "npm": "@ai-sdk/openai-compatible",\n      "name": "Ollama",\n      "options": {\n        "baseURL": "http://127.0.0.1:11434/v1"\n      },\n      "models": {\n'
for i in "${!MODELS[@]}"; do
 comma="," 
 [ "$i" -eq $((${#MODELS[@]}-1)) ] && comma=""
 printf '        "%s": {"name": "%s", "limit": {"context": %s, "output": %s}}%s\n' "${MODELS[$i]}" "${MODELS[$i]}" "$OLLAMA_CONTEXT_LENGTH" "$OUTPUT_CAP" "$comma"
done
printf '      }\n    }\n  }\n}\n'
} > "$DEST" 2>/dev/null || return 1
echo "Generated OpenCode Ollama provider config (.config/opencode/opencode.json in Ubuntu home)"
return 0
}

#Like generate_opencode_config, but respects an existing user config.
#Returns 0 if a provider config is usable, non-zero otherwise.
sync_opencode_config(){
if proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc '[ -f "$HOME/.config/opencode/opencode.json" ]' >/dev/null 2>&1; then
 return 0
fi
generate_opencode_config
}

#Menu action: discard any existing OpenCode config and regenerate it from the
#current Ollama model list (e.g. after importing a new model).
regen_opencode_config(){
DEST="$PREFIX/var/lib/proot-distro/containers/$UBUNTU_DISTRO_NAME/rootfs/root/.config/opencode/opencode.json"
if [ -f "$DEST" ]; then
 read -p "Overwrite existing .config/opencode/opencode.json in Ubuntu home? [y/N] " ans
 case "$ans" in
  [Yy]*) ;;
  *) echo "Aborted."; return 1 ;;
 esac
fi
generate_opencode_config || echo "No models to register - import one first ('code' > 2)"
}

opencode_launch(){
OC=$(ubuntu_which opencode)
if [ -z "$OC" ]; then
 echo "OpenCode is not installed - run 'update-ai' to install it"
 exit 1
fi
select_model cloud
CONFIG_OK=1
sync_opencode_config || CONFIG_OK=0
MODEL_ARGS=""
if [ "$MODEL" = "__CLOUD__" ]; then
 : # bare launch - opencode uses its own default cloud model
elif [ "$CONFIG_OK" = 1 ]; then
 MODEL_ARGS="--model ollama/$MODEL"
else
 echo "Warning: no Ollama models found - OpenCode will use its default model"
fi
select_project
# Launch by absolute path with NO PATH extension: device bisect proved that
# exporting the nvm/.local PATH prefix wedges opencode's startup (hang), while
# plain 'cd + absolute-path binary' renders instantly. If a runtime feature
# ever needs node on PATH, revisit with a narrower export.
proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc "cd projects/$PROJECT_NAME && '$OC' $MODEL_ARGS"
}

freebuff_launch(){
FB=$(ubuntu_which freebuff)
if [ -z "$FB" ]; then
 echo "Freebuff is not installed - run 'update-ai' to install it"
 exit 1
fi
# The npm 'freebuff' shim starts '#!/usr/bin/env node' - and a non-interactive
# 'bash -lc' has no nvm PATH, so env cannot find node (device-verified:
# "env: 'node': No such file or directory"). The shim is a self-contained JS
# entry file, so run it directly with node's absolute path - same lesson as
# the opencode launch: never depend on PATH inside the launch shell.
NODE_BIN=$(ubuntu_which node)
if [ -z "$NODE_BIN" ]; then
 echo "node is not installed in Ubuntu - run 'update-ai'"
 exit 1
fi
select_project
proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc "cd projects/$PROJECT_NAME && '$NODE_BIN' '$FB'"
}

import_model(){
[ -d "$GGUF_DIR" ] || { echo "Models directory not found: $GGUF_DIR"; exit 1; }
while true; do
 mapfile -t G < <(find "$GGUF_DIR" -maxdepth 1 -name "*.gguf"|sort)
 [ ${#G[@]} -gt 0 ] && break
 echo "No .gguf files found in $GGUF_DIR."
 read -p "Add .gguf files there, then press Enter to retry (q to quit): " r
 case "$r" in
  [Qq]*) exit 1 ;;
 esac
done
echo "GGUF files:"
select f in "${G[@]}"; do [ -n "$f" ] && break; done
read -p "Model name: " N
TMP=$(mktemp)
echo "FROM \"$f\"" > "$TMP"
ollama create "$N" -f "$TMP"
rm -f "$TMP"
}

restart_ollama(){ pkill ollama || true; nohup ollama serve >/dev/null 2>&1 & sleep 3; }

bench_model(){
mapfile -t MODELS < <(ollama list|awk 'NR>1{print $1}')
[ ${#MODELS[@]} -eq 0 ] && { echo "No models to benchmark."; return 1; }
echo "Models:"
for i in "${!MODELS[@]}"; do printf "%2d) %s\n" $((i+1)) "${MODELS[$i]}"; done
read -p "Model to benchmark [1]: " c
c=${c:-1}
case "$c" in ''|*[!0-9]*) c=1 ;; esac
[ "$c" -lt 1 ] && c=1
[ "$c" -gt ${#MODELS[@]} ] && c=${#MODELS[@]}
MODEL="${MODELS[$((c-1))]}"
echo "Benchmarking $MODEL (warmup + timed run, ~2-5 min)..."
#Warmup: forces the model fully resident so the timed run measures generation,
#not cold-load. keep_alive=-1 keeps it resident for repeat runs.
curl -s -m 300 http://127.0.0.1:11434/api/generate -d '{"model":"'"$MODEL"'","prompt":"hi","raw":true,"keep_alive":-1}' >/dev/null
START=$(date +%s)
#num_predict raised: Ollama's default cap (128) can end the run early and
#shrink the sample; stream:false returns one JSON with full timing stats.
RESP=$(curl -s -m 300 http://127.0.0.1:11434/api/generate -d '{"model":"'"$MODEL"'","prompt":"Count from 1 to 100.","raw":true,"keep_alive":-1,"num_predict":256,"stream":false}')
END=$(date +%s)
EVALC=$(printf '%s' "$RESP" | grep -o '"eval_count":[0-9]*' | cut -d: -f2 | tail -1)
EVALD=$(printf '%s' "$RESP" | grep -o '"eval_duration":[0-9]*' | cut -d: -f2 | tail -1)
if [ -z "$EVALC" ] || [ "$EVALC" = "0" ]; then
 EVALC=$(printf '%s' "$RESP" | grep -c '"response"')
 EVALD=""
fi
if [ -z "$EVALC" ] || [ "$EVALC" = "0" ]; then
 echo "No output generated - check 'ollama ps' and try again."
 return 1
fi
SECS=$(( END - START ))
[ "$SECS" -eq 0 ] && SECS=1
#eval_duration is nanoseconds: tok/s = eval_count / (eval_duration / 1e9).
#Decode rate is the number that matters (excludes wall-clock overhead);
#awk for one decimal - integer division rounded 1.9 down to 1.
DECODE=$(awk -v c="$EVALC" -v d="$EVALD" 'BEGIN{ if (d+0 > 0) printf "%.1f", c/(d/1e9); else print "?" }')
AVG=$(awk -v c="$EVALC" -v s="$SECS" 'BEGIN{ printf "%.1f", c/s }')
echo "generated $EVALC tokens in ${SECS}s"
echo "  decode: ${DECODE} tok/s (pure generation speed, from Ollama timings)"
echo "  whole-run average: ${AVG} tok/s"
echo "Use bench.py / bench_all.py for the prompt-eval vs decode split and llama.cpp numbers."
}

start_ollama
status
echo "1) Launch Aider"
echo "2) Import GGUF"
echo "3) Chat"
echo "4) Update AI"
echo "5) Doctor AI"
echo "6) Restart Ollama"
echo "7) OpenCode"
echo "8) Clear Cache"
echo "9) Freebuff"
echo "10) Regen OpenCode Config"
echo "11) Benchmark Model"
echo "12) Quit"
read -p "Choice: " m
case "$m" in
1) launch;;
2) import_model;;
3) chat;;
4) update-ai;;
5) doctor-ai;;
6) restart_ollama;;
7) opencode_launch;;
8) clear-ai-cache;;
9) freebuff_launch;;
10) regen_opencode_config;;
11) bench_model;;
*) exit 0;;
esac
