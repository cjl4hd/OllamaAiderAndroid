#!/data/data/com.termux/files/usr/bin/bash
set -e

# =============================================================================
# code — Termux-side launcher (host only).
#
# This half owns HOST things: the Ollama server and its env tuning, ollama
# CLI chat + GGUF import, package updates, benchmarks. Everything that lives
# inside proot Ubuntu (aider/opencode/freebuff pickers and launches, OpenCode
# config, adb-ai) belongs to code-ubuntu — reached via menu option 8, which
# runs ONE proot session with the Ubuntu-side menu. That split exists because
# host vs container is the repo's #1 bug class (see AGENTS.md rule 1).
#
# If you are already in an 'ubuntu' shell, skip this script entirely and run
# code-ubuntu directly.
# =============================================================================

CONFIG_FILE="$HOME/.ai-env.conf"
if [ ! -f "$CONFIG_FILE" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    echo "No $CONFIG_FILE found - running first-time setup via update-ai..."
    "$SCRIPT_DIR/update-ai" || exit 1
    [ -f "$CONFIG_FILE" ] || { echo "Setup did not complete - $CONFIG_FILE not created. Run 'update-ai' manually."; exit 1; }
fi
source "$CONFIG_FILE"

UBUNTU_DISTRO_NAME="${UBUNTU_DISTRO_NAME:-ubuntu}"
GGUF_DIR="${GGUF_DIR:-$HOME/storage/shared/Models}"
#Low-RAM threshold for the banner's ** LOW marker (same key adb-ai's
#auto-clean and code-ubuntu use - one config file repo-wide).
ADB_AI_LOW_RAM_GB="${ADB_AI_LOW_RAM_GB:-4}"

[ -d "$HOME/storage" ] || echo "Warning: shared storage not set up - GGUF import will fail (run 'update-ai')"

#Parameters to optimize for S26
#Force flahs attention, mandatory to unlock kv cache quantization
export OLLAMA_FLASH_ATTENTION=1

#Compress attention vectors to 8 bit int
export OLLAMA_KV_CACHE_TYPE=q8_0

#Ensure only 1 model used at a time
export OLLAMA_MAX_LOADED_MODELS=1

#Single request slot: Ollama's default (4) multiplies the KV cache 4x, which
#alone can push a 7b model past what the phone can hold. One user, one request
#at a time - override via OLLAMA_NUM_PARALLEL in ~/.ai-env.conf.
export OLLAMA_NUM_PARALLEL="${OLLAMA_NUM_PARALLEL:-1}"

#Default context window for requests that don't set num_ctx. OpenCode's agent
#loop wants 64k+, but phone RAM with q8_0 KV cache realistically caps lower.
#Override via OLLAMA_CONTEXT_LENGTH in ~/.ai-env.conf.
export OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-16384}"

#Keep the last-used model resident. Ollama's default is 5m, and on a phone a
#cold reload costs minutes - far worse than holding one model in idle RAM.
#Override via OLLAMA_KEEP_ALIVE in ~/.ai-env.conf ("-1" forever, "0" unload
#immediately, e.g. 30m if a big model squeezes the phone).
export OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:--1}"

#How long Ollama waits for a cold model load before giving up (default 5m).
#Phone flash + big models have landed right at that edge; raise the headroom.
#Override via OLLAMA_LOAD_TIMEOUT in ~/.ai-env.conf.
export OLLAMA_LOAD_TIMEOUT="${OLLAMA_LOAD_TIMEOUT:-15m}"

start_ollama() {
if ! pgrep -f "ollama serve" >/dev/null; then
 echo "Starting Ollama..."
 nohup ollama serve >/dev/null 2>&1 &
 sleep 3
fi
}

#Free RAM in GB from /proc/meminfo (Android kernels expose MemAvailable).
free_ram_gb(){
awk '/MemAvailable/{printf "%.1f", $2/1048576; exit}' /proc/meminfo 2>/dev/null
}

#Model metadata via the Ollama HTTP API - the SAME parsing as code-ubuntu's
#picker (kept in sync), so every menu shows identical info. The old ollama-CLI
#header parsing came back empty on some builds; the API JSON does not.
api(){ # path [post-data]
local path="$1" data="${2:-}"
if [ -n "$data" ]; then
 timeout -k 2 10 curl -s "http://127.0.0.1:11434$path" -d "$data" </dev/null 2>/dev/null || true
else
 timeout -k 2 10 curl -s "http://127.0.0.1:11434$path" </dev/null 2>/dev/null || true
fi
}

#Installed model names (MODELS) + on-disk sizes in GB (DISKS) from /api/tags.
#Temp file, not process substitution (/dev/fd is unreliable in proot); sizes
#get one decimal each - a missing newline here once merged two models' sizes
#into one bogus value.
load_models(){
local tags t
tags=$(api /api/tags)
if [ -z "$tags" ]; then MODELS=(); DISKS=(); return 1; fi
t=$(mktemp)
printf '%s' "$tags" | grep -oE '"name": *"[^"]*"' | sed 's/.*"name": *"//; s/"$//' > "$t"
mapfile -t MODELS < "$t"
printf '%s' "$tags" | grep -oE '"size": *[0-9]+' | grep -oE '[0-9]+' | awk '{printf "%.1f\n", $1/1e9}' > "$t"
mapfile -t DISKS < "$t"
rm -f "$t"
}

#One-line descriptor: parameter count, quantization, disk size (from /api/show).
model_meta(){ # $1=model, $2=diskGB (may be empty) -> sets META
local show params quant
show=$(api /api/show "{\"model\":\"$1\"}")
params=$(printf '%s' "$show" | grep -oE '"parameter_size": *"[^"]*"' | head -1 | sed 's/.*: *"//; s/"//')
quant=$(printf '%s' "$show" | grep -oE '"quantization_level": *"[^"]*"' | head -1 | sed 's/.*: *"//; s/"//')
META=""
[ -n "$params" ] && META="$params"
[ -n "$quant" ] && META="$META $quant"
if [ -n "$2" ] && [ "$2" != "0.0" ]; then META="$META - ${2}GB disk"; fi
return 0
}

#Status banner. Mirrored in code-ubuntu's cmd_status (kept in sync): same
#layout, same awk parsing. API-based (not pgrep / ollama CLI) so it reports
#the truth even when the server is hung, and the parsing survives compact
#JSON (one line, no spaces) on every Ollama build.
status_banner(){
local models loaded fr low
models=$(api /api/tags | awk '{n+=gsub(/"name":/, "&")} END{print n+0}')
loaded=$(api /api/ps | awk '{if (match($0, /"name": *"[^"]*"/)) {v=substr($0, RSTART, RLENGTH); sub(/^"name": *"/, "", v); sub(/"$/, "", v)} if (match($0, /"size": *[0-9]+/)) {s=substr($0, RSTART, RLENGTH); sub(/^"size": */, "", s)}} END{if (v != "") {if (s+0 > 0) printf "%s (%.1fGB)", v, s/1e9; else print v}}')
fr=$(free_ram_gb)
echo "====================================="
echo " AI Development Environment"
echo "====================================="
local up=""
if [ -n "$(api /api/version)" ]; then
 up=1
 echo "Ollama : Running"
else
 echo "Ollama : Unreachable (menu 5 restarts it)"
fi
#Down -> "?": an empty /api/tags means unknown, not zero - don't claim the
#models vanished just because the API is unreachable.
if [ -z "$up" ]; then
 echo "Models  : ?"
 echo "Loaded  : ?"
elif [ "$models" = "0" ]; then
 echo "Models  : 0  (add one: menu 2 imports a GGUF)"
 #"Loaded" = resident in RAM, not installed - after a restart it is none
 #until the first request; say so, or it reads like the models vanished.
 echo "Loaded  : ${loaded:-none (loads on first request)}"
else
 echo "Models  : $models"
 echo "Loaded  : ${loaded:-none (loads on first request)}"
fi
echo "Ctx     : $OLLAMA_CONTEXT_LENGTH"
if [ -n "$fr" ]; then
 low=""
 if awk -v f="$fr" -v t="${ADB_AI_LOW_RAM_GB:-4}" 'BEGIN{exit !(f+0<t+0)}'; then low="  ** LOW (quick clean: menu 7)"; fi
 echo "FreeRAM : ${fr}GB${low}"
else
 echo "FreeRAM : ?GB"
fi
echo
return 0
}

#Host-side model picker for chat (ollama CLI - no container involvement).
#rc 0 = MODEL set, rc 1 = nothing to pick, rc 130 = user cancelled (0).
select_model_host(){
local last="" mark
#|| true: an unreachable Ollama makes load_models fail, and set -e would kill
#us here instead of reaching the friendly "No models" message below.
load_models || true
[ ${#MODELS[@]} -eq 0 ] && { echo "No models. Import one first (menu 2)."; return 1; }
FREE=$(free_ram_gb)
[ -n "$FREE" ] && echo "Free RAM: ${FREE}GB (model + its context KV cache must fit)"
echo "Installed models:"
for i in "${!MODELS[@]}"; do
 mark=""
 model_meta "${MODELS[$i]}" "${DISKS[$i]:-}"
 printf "%2d) %-38s %s\n" $((i+1)) "${MODELS[$i]}" "$META"
done
echo " 0) Cancel"
read -p "Choose model [1]: " c
c=${c:-1}
case "$c" in ''|*[!0-9]*) c=1 ;; esac
[ "$c" -eq 0 ] && return 130
[ "$c" -lt 1 ] && c=1
[ "$c" -gt ${#MODELS[@]} ] && c=${#MODELS[@]}
MODEL="${MODELS[$((c-1))]}"
return 0
}

chat(){
#rc 130 = user cancelled -> back to the caller quietly (no stray ollama run).
select_model_host || return 0
ollama run "$MODEL"
}

#Menu action: run the Ubuntu-side dev menu (aider/opencode/freebuff/adb-ai)
#in ONE proot session. Flat command with no PATH exports and no nested
#quoting - the launch-string bugs of the old design can't happen here.
ubuntu_menu(){
proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc '
if command -v code-ubuntu >/dev/null 2>&1; then exec code-ubuntu; fi
if [ -x /root/projects/*/code-ubuntu ]; then exec /root/projects/*/code-ubuntu; fi
echo "code-ubuntu not found in Ubuntu - git pull the repo there and run update-ai"'
}

import_model(){
[ -d "$GGUF_DIR" ] || { echo "Models directory not found: $GGUF_DIR"; exit 1; }
while true; do
 mapfile -t G < <(find "$GGUF_DIR" -maxdepth 1 -name "*.gguf"|sort)
 [ ${#G[@]} -gt 0 ] && break
 echo "No .gguf files found in $GGUF_DIR."
 read -p "Add .gguf files there, then press Enter to retry (q to quit): " r
 case "$r" in
  [Qq]*) exit 1 ;;
 esac
done
echo "GGUF files:"
select f in "${G[@]}"; do [ -n "$f" ] && break; done
read -p "Model name: " N
TMP=$(mktemp)
echo "FROM \"$f\"" > "$TMP"
ollama create "$N" -f "$TMP"
rm -f "$TMP"
}

restart_ollama(){ pkill ollama || true; nohup ollama serve >/dev/null 2>&1 & sleep 3; }

bench_model(){
#|| true: see select_model_host - the count check handles the empty case.
load_models || true
[ ${#MODELS[@]} -eq 0 ] && { echo "No models to benchmark."; return 1; }
FREE=$(free_ram_gb)
[ -n "$FREE" ] && echo "Free RAM: ${FREE}GB"
echo "Models:"
for i in "${!MODELS[@]}"; do
 model_meta "${MODELS[$i]}" "${DISKS[$i]:-}"
 printf "%2d) %-38s %s\n" $((i+1)) "${MODELS[$i]}" "$META"
done
echo " 0) Cancel"
read -p "Model to benchmark [1]: " c
c=${c:-1}
case "$c" in ''|*[!0-9]*) c=1 ;; esac
[ "$c" -eq 0 ] && return 0
[ "$c" -lt 1 ] && c=1
[ "$c" -gt ${#MODELS[@]} ] && c=${#MODELS[@]}
MODEL="${MODELS[$((c-1))]}"
echo "Benchmarking $MODEL (warmup + decode probe + prefill probe, ~2-5 min)..."
#Warmup: forces the model fully resident so the probes measure compute,
#not cold-load. keep_alive=-1 keeps it resident for repeat runs.
curl -s -m 300 http://127.0.0.1:11434/api/generate -d '{"model":"'"$MODEL"'","prompt":"hi","raw":true,"keep_alive":-1}' >/dev/null
#Decode probe: short prompt, generous num_predict (Ollama's default cap of 128
#can end the run early). stream:false returns one JSON with full timing stats.
RESP=$(curl -s -m 300 http://127.0.0.1:11434/api/generate -d '{"model":"'"$MODEL"'","prompt":"Count from 1 to 100.","raw":true,"keep_alive":-1,"num_predict":256,"stream":false}')
EVALC=$(printf '%s' "$RESP" | grep -o '"eval_count":[0-9]*' | cut -d: -f2 | tail -1)
EVALD=$(printf '%s' "$RESP" | grep -o '"eval_duration":[0-9]*' | cut -d: -f2 | tail -1)
#Prefill probe: a big no-op prompt (num_predict=1 keeps output negligible)
#makes prompt_eval dominate - this is the per-turn cost of OpenCode's fat
#agent prompts.
PREFILL_PROMPT=$(printf 'x%.0s' $(seq 1 400))
PRESP=$(curl -s -m 300 http://127.0.0.1:11434/api/generate -d '{"model":"'"$MODEL"'","prompt":"'"$PREFILL_PROMPT"'","raw":true,"keep_alive":-1,"num_predict":1,"stream":false}')
PROMPTC=$(printf '%s' "$PRESP" | grep -o '"prompt_eval_count":[0-9]*' | cut -d: -f2 | tail -1)
PROMPTD=$(printf '%s' "$PRESP" | grep -o '"prompt_eval_duration":[0-9]*' | cut -d: -f2 | tail -1)
if [ -z "$EVALC" ] || [ "$EVALC" = "0" ]; then
 EVALC=$(printf '%s' "$RESP" | grep -c '"response"')
 EVALD=""
fi
if [ -z "$EVALC" ] || [ "$EVALC" = "0" ]; then
 echo "No output generated - check 'ollama ps' and try again."
 return 1
fi
#Durations are nanoseconds: tok/s = count / (duration / 1e9). 2 decimals so
#sub-tok/s phone speeds stay meaningful.
DECODE=$(awk -v c="$EVALC" -v d="$EVALD" 'BEGIN{ if (d+0 > 0) printf "%.2f", c/(d/1e9); else print "?" }')
PREFILL=""
if [ -n "$PROMPTC" ] && [ "$PROMPTC" != "0" ] && [ -n "$PROMPTD" ]; then
 PREFILL=$(awk -v c="$PROMPTC" -v d="$PROMPTD" 'BEGIN{ printf "%.2f", c/(d/1e9) }')
fi
echo "decode probe: $EVALC tokens"
echo "  decode:  ${DECODE} tok/s  (generation speed)"
[ -n "$PREFILL" ] && echo "  prefill: ${PREFILL} tok/s  (prompt processing, 400-token probe)"
#Actual loaded footprint (weights + KV cache at the active ctx) from /api/ps:
#KV-cache RAM varies with architecture, so measure it instead of estimating.
PS_JSON=$(curl -s -m 5 http://127.0.0.1:11434/api/ps)
PSIZE=$(printf '%s' "$PS_JSON" | grep -o '"size":[0-9.]*' | cut -d: -f2 | head -1)
PCTX=$(printf '%s' "$PS_JSON" | grep -o '"context_length":[0-9]*' | cut -d: -f2 | head -1)
if [ -n "$PSIZE" ]; then
 PSGB=$(awk -v b="$PSIZE" 'BEGIN{ printf "%.1f", b/1e9 }')
 echo "  loaded:  ${PSGB}GB RAM (weights + KV cache${PCTX:+ at ctx $PCTX})"
fi
echo "Use bench.py / bench_all.py for llama.cpp-level detail."
}

start_ollama
status_banner
echo "1) Chat"
echo "2) Import GGUF"
echo "3) Update AI"
echo "4) Doctor AI"
echo "5) Restart Ollama"
echo "6) Benchmark Model"
echo "7) Clear Cache"
echo "8) Ubuntu Dev Menu (aider / opencode / freebuff / android memory)"
echo "9) Quit"
read -p "Choice: " m || exit 0
case "$m" in
1) chat;;
2) import_model;;
3) update-ai;;
4) doctor-ai;;
5) restart_ollama;;
6) bench_model;;
7) clear-ai-cache;;
8) ubuntu_menu;;
*) exit 0;;
esac
