#!/data/data/com.termux/files/usr/bin/bash
set -e

# =============================================================================
# code — Termux-side launcher (host only).
#
# This half owns HOST things: the llama.cpp server and its tuning, GGUF
# import, package updates, benchmarks. Everything that lives inside proot
# Ubuntu (aider/opencode/freebuff pickers and launches, OpenCode config,
# adb-ai) belongs to code-ubuntu — reached via menu option 9, which runs ONE
# proot session with the Ubuntu-side menu. That split exists because host vs
# container is the repo's #1 bug class (see AGENTS.md rule 1).
#
# If you are already in an 'ubuntu' shell, skip this script entirely and run
# code-ubuntu directly.
# =============================================================================

CONFIG_FILE="$HOME/.ai-env.conf"
if [ ! -f "$CONFIG_FILE" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    echo "No $CONFIG_FILE found - running first-time setup via update-ai..."
    "$SCRIPT_DIR/update-ai" || exit 1
    [ -f "$CONFIG_FILE" ] || { echo "Setup did not complete - $CONFIG_FILE not created. Run 'update-ai' manually."; exit 1; }
fi
source "$CONFIG_FILE"

UBUNTU_DISTRO_NAME="${UBUNTU_DISTRO_NAME:-ubuntu}"
GGUF_DIR="${GGUF_DIR:-$HOME/storage/shared/Models}"
#Low-RAM threshold for the banner's ** LOW marker (same key adb-ai's
#auto-clean and code-ubuntu use - one config file repo-wide).
ADB_AI_LOW_RAM_GB="${ADB_AI_LOW_RAM_GB:-4}"

[ -d "$HOME/storage" ] || echo "Warning: shared storage not set up - GGUF import will fail (run 'update-ai')"

#Pin the model store explicitly. A pkg upgrade of ollama can change the
#Model blob store (kept at the old Ollama path so nothing re-downloads):
#llama-server loads individual .gguf files from here; new imports land in
#LLAMA_MODELS_DIR (default ~/.llama/models).
OLLAMA_MODELS="${OLLAMA_MODELS:-$HOME/.ollama/models}"
LLAMA_MODELS_DIR="${LLAMA_MODELS_DIR:-$HOME/.llama/models}"

# ============================================================================
# llama.cpp server (PRIMARY engine since the Phase 3 Ollama retirement).
# Serves the GGUF blobs (kept under the old Ollama store path so nothing
# re-downloads) over an OpenAI-compatible API. Menus 5/6 manage it; aider and
# OpenCode in Ubuntu point at it. Override via LLAMA_SERVER_PORT / LLAMA_MODEL
# in ~/.ai-env.conf.
# ============================================================================
LLAMA_SERVER_PORT="${LLAMA_SERVER_PORT:-8080}"
LLAMA_MODEL="${LLAMA_MODEL:-auto}"
LLAMA_CONTEXT_LENGTH="${LLAMA_CONTEXT_LENGTH:-8192}"
#Threads for llama-server decode. 4 measured on the S26 (aarch64, CPU only).
LLAMA_THREADS="${LLAMA_THREADS:-4}"
LLAMA_MODELS_DIR="${LLAMA_MODELS_DIR:-$HOME/.llama/models}"

lapi() { # path
    timeout -k 2 10 curl -s "http://127.0.0.1:${LLAMA_SERVER_PORT:-8080}$1" </dev/null 2>/dev/null || true
}

#Resolve the installed llama-server (Termux pkg 'llama-cpp').
llama_bin(){
for c in "/data/data/com.termux/files/usr/bin/llama-server" "/usr/bin/llama-server"; do
    [ -x "$c" ] && { echo "$c"; return 0; }
done
command -v llama-server 2>/dev/null
}

#Pick a GGUF when LLAMA_MODEL=auto: newest .gguf in the import dir, else the
#biggest legacy Ollama blob (that store holds existing models; new imports
#land in LLAMA_MODELS_DIR).
llama_pick_model(){
local pick=""
pick=$(ls -t "${LLAMA_MODELS_DIR:-$HOME/.llama/models}"/*.gguf 2>/dev/null | head -1)
if [ -z "$pick" ]; then
    pick=$(ls -S "${OLLAMA_MODELS:-$HOME/.ollama/models}"/blobs/sha256-* 2>/dev/null | head -1)
fi
[ -n "$pick" ] && { echo "$pick"; return 0; }
return 1
}

start_llama_server(){
local bin i MODEL_PATH
bin=$(llama_bin) || { echo "llama-server not installed - run 'pkg install llama-cpp'"; return 1; }
#Exact-name process check, not pgrep -f (device lesson: pgrep -f matches
#probe command lines that contain the same words).
if pgrep -x llama-server >/dev/null 2>&1; then
    echo "llama-server already running (port $LLAMA_SERVER_PORT)"
    return 0
fi
if [ "$LLAMA_MODEL" = "auto" ]; then
    MODEL_PATH=$(llama_pick_model) || { echo "No .gguf found in ${LLAMA_MODELS_DIR:-$HOME/.llama/models} or the legacy Ollama blobs - import one via menu 2 first."; return 1; }
else
    MODEL_PATH="$LLAMA_MODEL"
    [ -f "$MODEL_PATH" ] || { echo "LLAMA_MODEL=$MODEL_PATH (from ~/.ai-env.conf) does not exist."; return 1; }
fi
echo "Starting llama-server (port $LLAMA_SERVER_PORT, ctx $LLAMA_CONTEXT_LENGTH, threads $LLAMA_THREADS)..."
: > "$HOME/.llama-server.log" 2>/dev/null || true
#nohup + log file + health-check wait.
#(Do NOT background this inside a subshell/one-shot call - the child gets
#cleaned up with the caller, device-verified.)
#--alias replaces the sha256-blob-hash /v1/models id (llama-server serves the
#file name as the model id, device-verified) with the blob's digest-free
#prefix so pickers show a readable name.
ALIAS=$(basename "$MODEL_PATH")
ALIAS=${ALIAS#sha256-}; ALIAS=${ALIAS%%-*}
ALIAS="llama-$ALIAS"
ohgup_exit=0
nohup "$bin" -m "$MODEL_PATH" --alias "$ALIAS" -c "$LLAMA_CONTEXT_LENGTH" --host 127.0.0.1 --port "$LLAMA_SERVER_PORT" -t "$LLAMA_THREADS" >> "$HOME/.llama-server.log" 2>&1 &
for i in $(seq 1 30); do
    curl -s -m 2 "http://127.0.0.1:$LLAMA_SERVER_PORT/health" </dev/null >/dev/null 2>&1 && { ohgup_exit=0; break; }
    sleep 1
    ohgup_exit=1
done
if [ "$ohgup_exit" -eq 0 ]; then
    echo "llama-server up at http://127.0.0.1:$LLAMA_SERVER_PORT (log: $HOME/.llama-server.log)"
    return 0
fi
echo "llama-server did not come up within 30s - check $HOME/.llama-server.log"
return 1
}

stop_llama_server(){
pkill -x llama-server 2>/dev/null || true
local i
for i in $(seq 1 10); do
    pgrep -x llama-server >/dev/null 2>&1 || return 0
    sleep 0.5
done
pkill -9 -x llama-server 2>/dev/null || true
sleep 1
return 0
}

#Restart = stop + start, so a config change reaches the running server
#(menu 5).
restart_llama_server(){
stop_llama_server
start_llama_server
}

#Free RAM in GB from /proc/meminfo (Android kernels expose MemAvailable).
free_ram_gb(){
awk '/MemAvailable/{printf "%.1f", $2/1048576; exit}' /proc/meminfo 2>/dev/null
}

#Installed model names (MODELS) + on-disk sizes in GB (DISKS) straight from
#the GGUF files directory (no registry after the Ollama retirement - the
#filesystem is the model list). Temp file, not process substitution (/dev/fd
#is unreliable in proot); sizes get one decimal each - a missing newline here
#once merged two models' sizes into one bogus value.
load_models(){
local dir="${LLAMA_MODELS_DIR:-$HOME/.llama/models}" t f sz
#NOTE: find with -o needs explicit grouping; the double -maxdepth form below
#would silently misparse. List the import dir and the legacy blob store
#separately instead (blobs have no .gguf suffix, so they are matched as-is).
{ find "$dir" -maxdepth 2 -name "*.gguf" 2>/dev/null;
  find "${OLLAMA_MODELS:-$HOME/.ollama/models}/blobs" -maxdepth 1 -type f -size +100M 2>/dev/null; } | sort -u > /tmp/ll_candidates.$$
mapfile -t GFILES < /tmp/ll_candidates.$$
rm -f /tmp/ll_candidates.$$
MODELS=(); DISKS=()
for f in "${GFILES[@]}"; do
    [ -f "$f" ] || continue
    MODELS+=("$f")
    sz=$(stat -c %s "$f" 2>/dev/null || echo 0)
    DISKS+=("$(awk -v b="$sz" 'BEGIN{printf "%.1f", b/1e9}')")
done
[ ${#MODELS[@]} -gt 0 ] || return 1
}

#One-line descriptor: file path + size (no registry metadata anymore).
model_meta(){ # $1=model path, $2=diskGB
META="$2GB"
return 0
}

#Status banner. Mirrored in code-ubuntu's cmd_status (kept in sync): same
#layout, same awk parsing. API-based (not pgrep / ollama CLI) so it reports
#the truth even when the server is hung, and the parsing survives compact
#JSON (one line, no spaces) on every Ollama build.
status_banner(){
local lm loaded fr low notify
# llama.cpp is the primary engine (Ollama retired in Phase 3). Model id
# comes from /v1/models; llama-server reports the live context in its log.
lm=$(lapi "/v1/models" | grep -oE '"id": *"[^"]*"' | head -1 | sed 's/.*"id": *"//; s/"//')
fr=$(free_ram_gb)
echo "====================================="
echo " AI Development Environment"
echo "====================================="
if pgrep -x llama-server >/dev/null 2>&1; then
 echo "llama.cpp : Running (http://127.0.0.1:${LLAMA_SERVER_PORT:-8080})"
 echo "Model    : ${lm:-loading...}"
else
 echo "llama.cpp : Not running (menu 5 starts it)"
 echo "Model    : -"
fi
echo "Ctx      : $LLAMA_CONTEXT_LENGTH"
if [ -n "$fr" ]; then
 low=""
 if awk -v f="$fr" -v t="${ADB_AI_LOW_RAM_GB:-4}" 'BEGIN{exit !(f+0<t+0)}'; then low="  ** LOW (quick clean: menu 8 / adb-ai)"; fi
 echo "FreeRAM  : ${fr}GB${low}"
else
 echo "FreeRAM  : ?GB"
fi
echo
return 0
}

#Host-side model picker for chat (ollama CLI - no container involvement).
#rc 0 = MODEL set, rc 1 = nothing to pick, rc 130 = user cancelled (0).
select_model_host(){
local last="" mark
#|| true: an unreachable Ollama makes load_models fail, and set -e would kill
#us here instead of reaching the friendly "No models" message below.
load_models || true
[ ${#MODELS[@]} -eq 0 ] && { echo "No models. Import one first (menu 2)."; return 1; }
FREE=$(free_ram_gb)
[ -n "$FREE" ] && echo "Free RAM: ${FREE}GB (model + its context KV cache must fit)"
echo "Installed models:"
for i in "${!MODELS[@]}"; do
 mark=""
 model_meta "${MODELS[$i]}" "${DISKS[$i]:-}"
 printf "%2d) %-38s %s\n" $((i+1)) "${MODELS[$i]}" "$META"
done
echo " 0) Cancel"
read -p "Choose model [1]: " c
c=${c:-1}
case "$c" in ''|*[!0-9]*) c=1 ;; esac
[ "$c" -eq 0 ] && return 130
[ "$c" -lt 1 ] && c=1
[ "$c" -gt ${#MODELS[@]} ] && c=${#MODELS[@]}
MODEL="${MODELS[$((c-1))]}"
return 0
}

chat(){
#Host chat: llama-server's own web UI/port-8080 is the primary engine now.
#Start it on demand if it's down, then chat through llama-cli against it.
pgrep -x llama-server >/dev/null 2>&1 || start_llama_server || return 0
select_model_host || return 0
llama-cli -m "$MODEL" -c 4096 --simple 2>/dev/null || \
    llama-cli -m "$MODEL" -cv 2>/dev/null || \
    { echo "Chat failed - open llama-server's web UI: http://127.0.0.1:${LLAMA_SERVER_PORT:-8080}"; return 1; }
}

#Menu action: run the Ubuntu-side dev menu (aider/opencode/freebuff/adb-ai)
#in ONE proot session. Flat command with no PATH exports and no nested
#quoting - the launch-string bugs of the old design can't happen here.
ubuntu_menu(){
proot-distro login "$UBUNTU_DISTRO_NAME" -- bash -lc '
if command -v code-ubuntu >/dev/null 2>&1; then exec code-ubuntu; fi
if [ -x /root/projects/*/code-ubuntu ]; then exec /root/projects/*/code-ubuntu; fi
echo "code-ubuntu not found in Ubuntu - git pull the repo there and run update-ai"'
}

import_model(){
[ -d "$GGUF_DIR" ] || { echo "Models directory not found: $GGUF_DIR"; exit 1; }
while true; do
 mapfile -t G < <(find "$GGUF_DIR" -maxdepth 1 -name "*.gguf"|sort)
 [ ${#G[@]} -gt 0 ] && break
 echo "No .gguf files found in $GGUF_DIR."
 read -p "Add .gguf files there, then press Enter to retry (q to quit): " r
 case "$r" in
  [Qq]*) exit 1 ;;
 esac
done
echo "GGUF files:"
select f in "${G[@]}"; do [ -n "$f" ] && break; done
# No registry anymore (Ollama retired): importing = moving the file into the
# models dir llama-server loads from. cp first so the source stays until the
# copy landed (phone flash interrupting a mv is how files used to vanish).
mkdir -p "${LLAMA_MODELS_DIR:-$HOME/.llama/models}"
cp -v "$f" "${LLAMA_MODELS_DIR:-$HOME/.llama/models}/" \
    && echo "Imported: available to llama-server on next start (menu 5)."
}



bench_model(){
#|| true: see select_model_host - the count check handles the empty case.
load_models || true
[ ${#MODELS[@]} -eq 0 ] && { echo "No models to benchmark."; return 1; }
FREE=$(free_ram_gb)
[ -n "$FREE" ] && echo "Free RAM: ${FREE}GB"
echo "Models:"
for i in "${!MODELS[@]}"; do
 model_meta "${MODELS[$i]}" "${DISKS[$i]:-}"
 printf "%2d) %-38s %s\n" $((i+1)) "${MODELS[$i]}" "$META"
done
echo " 0) Cancel"
read -p "Model to benchmark [1]: " c
c=${c:-1}
case "$c" in ''|*[!0-9]*) c=1 ;; esac
[ "$c" -eq 0 ] && return 0
[ "$c" -lt 1 ] && c=1
[ "$c" -gt ${#MODELS[@]} ] && c=${#MODELS[@]}
MODEL="${MODELS[$((c-1))]}"
echo "Benchmarking $(basename "$MODEL") via llama-server probes (~2-5 min)..."
#Server reload with the chosen file (stop/start is how a model switches).
stop_llama_server
LLAMA_MODEL="$MODEL" start_llama_server || { echo "Server start failed - cannot benchmark."; return 1; }
ID=$(lapi /v1/models | grep -oE '"id": *"[^"]*"' | head -1 | sed 's/.*"id": *"//; s/"//')
[ -z "$ID" ] && { echo "No model registered on the server."; return 1; }
#Warmup.
curl -s -m 300 "http://127.0.0.1:$LLAMA_SERVER_PORT/v1/chat/completions" \
 -H "Content-Type: application/json" \
 -d "{\"model\":\"$ID\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":8,\"stream\":false\}" >/dev/null
#Decode probe: llama-server's timings block carries predicted_ms/predicted_n.
DRESP=$(curl -s -m 300 "http://127.0.0.1:$LLAMA_SERVER_PORT/v1/chat/completions" \
 -H "Content-Type: application/json" \
 -d "{\"model\":\"$ID\",\"messages\":[{\"role\":\"user\",\"content\":\"Count from 1 to 100 without explanation\"}],\"max_tokens\":256,\"stream\":false\}")
EVALC=$(printf '%s' "$DRESP" | grep -o '"predicted_n":[0-9]*' | cut -d: -f2 | head -1)
EVALD=$(printf '%s' "$DRESP" | grep -o '"predicted_ms":[0-9.]*' | cut -d: -f2 | head -1)
#Prefill probe: a fat no-op prompt makes prompt processing dominate - the
#per-turn cost of OpenCode's fat agent prompts.
NP=$(printf 'x%.0s' $(seq 1 400))
PRESP=$(curl -s -m 300 "http://127.0.0.1:$LLAMA_SERVER_PORT/v1/chat/completions" \
 -H "Content-Type: application/json" \
 -d "{\"model\":\"$ID\",\"messages\":[{\"role\":\"user\",\"content\":\"$NP\"}],\"max_tokens\":1,\"stream\":false\}")
PROMPTC=$(printf '%s' "$PRESP" | grep -o '"prompt_n":[0-9]*' | cut -d: -f2 | head -1)
PROMPTD=$(printf '%s' "$PRESP" | grep -o '"prompt_ms":[0-9.]*' | cut -d: -f2 | head -1)
if [ -z "$EVALC" ] || [ "$EVALC" = "0" ]; then
 echo "No output generated - check $HOME/.llama-server.log and try again."
 return 1
fi
#timings are milliseconds: tok/s = count / (ms/1000). 2 decimals so sub-tok/s
#phone speeds stay meaningful.
DECODE=$(awk -v c="$EVALC" -v d="$EVALD" 'BEGIN{ if (d+0 > 0) printf "%.2f", c/(d/1000); else print "?" }')
PREFILL=""
if [ -n "$PROMPTC" ] && [ "$PROMPTC" != "0" ] && [ -n "$PROMPTD" ]; then
 PREFILL=$(awk -v c="$PROMPTC" -v d="$PROMPTD" 'BEGIN{ if (d+0 > 0) printf "%.2f", c/(d/1000); else print "?" }')
fi
echo "decode probe: $EVALC tokens"
echo "  decode:  ${DECODE} tok/s  (generation speed)"
[ -n "$PREFILL" ] && echo "  prefill: ${PREFILL} tok/s  (prompt processing, 400-token probe)"
echo "Use bench.py / bench_all.py for llama.cpp-level detail (direct llama-cli)."
}

status_banner
echo "1) Chat"
echo "2) Import GGUF"
echo "3) Update AI"
echo "4) Doctor AI"
echo "5) llama.cpp: Start/Restart server"
echo "6) llama.cpp: Stop server"
echo "7) Benchmark Model"
echo "8) Clear Cache"
echo "9) Ubuntu Dev Menu (aider / opencode / freebuff / android memory)"
echo "10) Quit"
read -p "Choice: " m || exit 0
case "$m" in
1) chat;;
2) import_model;;
3) update-ai;;
4) doctor-ai;;
5) restart_llama_server || true;;
6) stop_llama_server;;
7) bench_model;;
8) clear-ai-cache;;
9) ubuntu_menu;;
*) exit 0;;
esac
